        // 2. Seguridad & EPP
        { id: 201, category: "epp", division: "Seguridad & EPP", brand: "3M", name: "Respiradores de Medio Rostro Serie 6200 / 7500", specs: "Norma NIOSH / OSHA • Filtros P100", image: "https://images.unsplash.com/photo-1584634731339-252c581abfc5?auto=format&fit=crop&w=600&q=80" },
