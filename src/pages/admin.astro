---
import '../styles/global.css';
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Panel de Administración & CMS Integral | SERVITOTALES S.A.C.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'dark';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased min-h-screen font-sans flex flex-col selection:bg-red-600 selection:text-white">
    
    <!-- Top Admin Header -->
    <header class="sticky top-0 z-50 w-full px-4 sm:px-6 py-2.5 bg-slate-900/95 border-b border-slate-800 backdrop-blur-md flex items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <a href="/admin" class="flex items-center gap-2.5 group">
          <div class="w-8 h-8 rounded-lg bg-red-600 text-white font-black flex items-center justify-center text-sm shadow-md group-hover:scale-105 transition-transform">
            ST
          </div>
          <div class="flex flex-col">
            <span class="text-sm font-black tracking-wider text-white font-heading leading-tight">
              SERVI<span class="text-red-500">TOTALES</span> <span class="text-[10px] font-mono font-medium text-slate-400">ADMIN</span>
            </span>
            <span class="text-[8px] font-mono font-bold text-amber-400 tracking-wider">SGC ISO 9001:2015</span>
          </div>
        </a>

        <div class="hidden md:flex items-center gap-2 pl-4 border-l border-slate-800 text-[11px] text-slate-400 font-mono">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Panel de Gestión en Vivo</span>
        </div>
      </div>

      <div class="flex items-center gap-2.5">
        <a
          href="/"
          target="_blank"
          class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-300 hover:text-white bg-slate-800/80 hover:bg-slate-800 transition flex items-center gap-1.5 border border-slate-700/60"
        >
          <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          <span class="hidden sm:inline">Ver Sitio Web</span>
        </a>

        <div class="hidden sm:flex items-center gap-2 px-2.5 py-1 rounded-lg bg-slate-800/60 border border-slate-700/50 text-xs">
          <div class="w-2 h-2 rounded-full bg-blue-400"></div>
          <span class="font-mono text-[11px] text-slate-300 font-medium" id="admin-user-badge">admin@servitotales.com</span>
        </div>

        <button
          type="button"
          id="btn-admin-logout"
          class="px-3 py-1.5 rounded-lg bg-red-500/10 text-red-400 hover:bg-red-600 hover:text-white transition text-xs font-semibold border border-red-500/20 flex items-center gap-1.5 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
          <span class="hidden sm:inline">Cerrar Sesión</span>
        </button>
      </div>
    </header>

    <!-- Main Workspace -->
    <div class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 flex flex-col lg:flex-row gap-6">
      
      <!-- Left Navigation Menu -->
      <aside class="w-full lg:w-64 shrink-0 space-y-4">
        <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 shadow-lg space-y-1" id="admin-main-nav">
          <span class="text-[10px] font-mono font-bold text-slate-500 uppercase tracking-wider px-3 py-1.5 block">
            Navegación del Administrador
          </span>

          <button
            type="button"
            data-tab="cms"
            class="admin-nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold transition-all text-white bg-red-600 shadow-md cursor-pointer"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
            <span>Editor de Textos (CMS)</span>
          </button>

          <button
            type="button"
            data-tab="catalog"
            class="admin-nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold transition-all text-slate-400 hover:text-white hover:bg-slate-800/80 cursor-pointer"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            <span>Gestor de Productos & Fotos</span>
          </button>

          <button
            type="button"
            data-tab="leads"
            class="admin-nav-btn w-full flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-bold transition-all text-slate-400 hover:text-white hover:bg-slate-800/80 cursor-pointer"
          >
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            <span>Mesa de Cotizaciones Web</span>
          </button>
        </div>

        <div class="p-3.5 rounded-2xl bg-slate-900 border border-slate-800 text-xs space-y-2">
          <div class="flex items-center justify-between text-slate-400">
            <span class="font-mono text-[10px] uppercase font-bold">Total Catálogo Activo</span>
            <span class="font-mono text-xs text-white font-bold" id="total-catalog-badge">45 Productos</span>
          </div>
          <p class="text-[11px] text-slate-400">Maquinaria, Minería Trackless, EPP y Suministros con fotografías oficiales.</p>
        </div>
      </aside>

      <!-- Main Content Panel -->
      <main class="flex-1 space-y-6 min-w-0">
        
        <!-- ========================================================================= -->
        <!-- 1. MÓDULO CMS: EDITOR COMPLETO DE TODOS LOS TEXTOS DE TODAS LAS PÁGINAS -->
        <!-- ========================================================================= -->
        <div id="panel-cms" class="admin-tab-panel space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-slate-800 pb-3">
            <div>
              <h1 class="text-xl font-black text-white font-heading">Editor de Contenidos & Textos (CMS)</h1>
              <p class="text-xs text-slate-400">Selecciona la página que deseas modificar. Todos los campos son editables.</p>
            </div>
            <span id="cms-save-indicator" class="hidden text-xs font-mono text-emerald-400 bg-emerald-500/10 px-3 py-1 rounded-lg border border-emerald-500/30">
              Cambios Guardados
            </span>
          </div>

          <!-- Page Tabs for CMS -->
          <div class="flex flex-wrap gap-2 p-1.5 rounded-xl bg-slate-900 border border-slate-800" id="cms-page-tabs">
            <button type="button" data-page="home" class="cms-page-btn px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-red-600 transition">1. Inicio (Portada)</button>
            <button type="button" data-page="nosotros" class="cms-page-btn px-3 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition">2. Nosotros & ISO</button>
            <button type="button" data-page="maquinaria" class="cms-page-btn px-3 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition">3. Maquinaria</button>
            <button type="button" data-page="epp" class="cms-page-btn px-3 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition">4. Seguridad & EPP</button>
            <button type="button" data-page="suministros" class="cms-page-btn px-3 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition">5. Suministros</button>
            <button type="button" data-page="contacto" class="cms-page-btn px-3 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition">6. Contacto & Header</button>
          </div>

          <form id="form-master-cms" class="space-y-6">
            
            <!-- CMS PÁGINA 1: INICIO -->
            <div id="cms-page-home" class="cms-page-box space-y-4 p-5 rounded-2xl bg-slate-900 border border-slate-800">
              <h2 class="text-xs font-mono font-bold text-red-400 uppercase tracking-wider">Contenidos de la Página de Inicio (/)</h2>
              
              <div class="space-y-3">
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Badge Superior del Hero</label>
                  <input type="text" id="c_home_badge" value="SGC ISO 9001:2015 • MINERÍA & CONSTRUCCIÓN" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Titular Principal del Hero (H1)</label>
                  <input type="text" id="c_home_title" value="Potenciamos tus operaciones y proyectos con Maquinaria y Suministros" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white font-bold" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Descripción / Bajada del Hero</label>
                  <textarea id="c_home_desc" rows="2" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-300">Aliado estratégico para construcción, minería y obras viales a nivel nacional. Flota moderna con operadores homologados, mantenimiento 24/7 y entrega directa en obra.</textarea>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                  <div>
                    <label class="block text-[11px] font-bold text-slate-400 mb-1">Píldora 1</label>
                    <input type="text" id="c_home_p1" value="Operadores Homologados" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white" />
                  </div>
                  <div>
                    <label class="block text-[11px] font-bold text-slate-400 mb-1">Píldora 2</label>
                    <input type="text" id="c_home_p2" value="Soporte en Sitio 24/7" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white" />
                  </div>
                  <div>
                    <label class="block text-[11px] font-bold text-slate-400 mb-1">Píldora 3</label>
                    <input type="text" id="c_home_p3" value="Despacho a Nivel Nacional" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white" />
                  </div>
                </div>

                <div class="pt-3 border-t border-slate-800 space-y-3">
                  <span class="text-xs font-mono font-bold text-slate-400 uppercase block">Sección de las 3 Divisiones en Portada</span>
                  <div>
                    <label class="block text-xs font-bold text-slate-300 mb-1">Título Sección Divisiones</label>
                    <input type="text" id="c_home_div_title" value="Soluciones Integrales para Minería, Construcción e Industria" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white" />
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-slate-300 mb-1">Subtítulo Sección Divisiones</label>
                    <input type="text" id="c_home_div_desc" value="Unidades de negocio homologadas para proyectos en costa, sierra y selva con despacho directo en obra." class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white" />
                  </div>
                </div>
              </div>
            </div>

            <!-- CMS PÁGINA 2: NOSOTROS -->
            <div id="cms-page-nosotros" class="cms-page-box hidden space-y-4 p-5 rounded-2xl bg-slate-900 border border-slate-800">
              <h2 class="text-xs font-mono font-bold text-blue-400 uppercase tracking-wider">Contenidos de Nosotros & ISO 9001 (/nosotros)</h2>
              
              <div class="space-y-3">
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Badge Superior</label>
                  <input type="text" id="c_nos_badge" value="02 // NOSOTROS & SGC ISO 9001:2015" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white font-mono" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Titular Principal H1</label>
                  <input type="text" id="c_nos_title" value="Liderazgo, Idoneidad Técnica y Compromiso con el País" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white font-bold" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Descripción de Trayectoria</label>
                  <textarea id="c_nos_desc" rows="2" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-300">Servicios Totales del Perú S.A.C. es un socio estratégico integral para los sectores más exigentes de minería, construcción e industria en todo el territorio nacional.</textarea>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label class="block text-xs font-bold text-slate-300 mb-1">Misión</label>
                    <textarea id="c_nos_mision" rows="2" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-300">Garantizar continuidad operativa y máxima seguridad en cada obra mediante equipos de alta disponibilidad.</textarea>
                  </div>
                  <div>
                    <label class="block text-xs font-bold text-slate-300 mb-1">Visión</label>
                    <textarea id="c_nos_vision" rows="2" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-300">Ser el referente nacional en alquiler de maquinaria pesada y suministro homologado para la gran minería.</textarea>
                  </div>
                </div>
              </div>
            </div>

            <!-- CMS PÁGINA 3: MAQUINARIA -->
            <div id="cms-page-maquinaria" class="cms-page-box hidden space-y-4 p-5 rounded-2xl bg-slate-900 border border-slate-800">
              <h2 class="text-xs font-mono font-bold text-red-400 uppercase tracking-wider">Contenidos de Maquinaria Pesada & Minería (/maquinaria)</h2>
              
              <div class="space-y-3">
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Badge Superior</label>
                  <input type="text" id="c_maq_badge" value="03 // CATÁLOGO DE FLOTA OPERATIVA" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white font-mono" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Titular Principal H1</label>
                  <input type="text" id="c_maq_title" value="Maquinaria Pesada & Minería Subterránea" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white font-bold" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Descripción del Catálogo de Maquinaria</label>
                  <textarea id="c_maq_desc" rows="2" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-300">Flota moderna en excelentes condiciones mecánicas, con checklist diario, planes de mantenimiento preventivo y operadores homologados para faenas de alta exigencia a nivel nacional.</textarea>
                </div>
              </div>
            </div>

            <!-- CMS PÁGINA 4: EPP -->
            <div id="cms-page-epp" class="cms-page-box hidden space-y-4 p-5 rounded-2xl bg-slate-900 border border-slate-800">
              <h2 class="text-xs font-mono font-bold text-amber-400 uppercase tracking-wider">Contenidos de Seguridad & EPP (/epp)</h2>
              
              <div class="space-y-3">
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Badge Superior</label>
                  <input type="text" id="c_epp_badge" value="04 // EQUIPOS DE PROTECCIÓN PERSONAL" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white font-mono" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Titular Principal H1</label>
                  <input type="text" id="c_epp_title" value="Seguridad Industrial & EPP Normado" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white font-bold" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Descripción del Catálogo de EPP</label>
                  <textarea id="c_epp_desc" rows="2" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-300">Abastecimiento mayorista y corporativo de implementos de seguridad industrial certificados ANSI, OSHA y NIOSH para faenas de alto riesgo en minería y obras civiles.</textarea>
                </div>
              </div>
            </div>

            <!-- CMS PÁGINA 5: SUMINISTROS -->
            <div id="cms-page-suministros" class="cms-page-box hidden space-y-4 p-5 rounded-2xl bg-slate-900 border border-slate-800">
              <h2 class="text-xs font-mono font-bold text-blue-400 uppercase tracking-wider">Contenidos de Ferretería & Suministros (/suministros)</h2>
              
              <div class="space-y-3">
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Badge Superior</label>
                  <input type="text" id="c_sum_badge" value="05 // FERRETERÍA & SUMINISTROS" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white font-mono" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Titular Principal H1</label>
                  <input type="text" id="c_sum_title" value="Ferretería Industrial, Mobiliario & Suministros" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white font-bold" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Descripción del Catálogo de Suministros</label>
                  <textarea id="c_sum_desc" rows="2" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-slate-300">Soluciones de aprovisionamiento continuo para campamentos mineros, talleres de maestranza y frentes de obra. Pernos de alta resistencia, abrasivos y mobiliario metálico.</textarea>
                </div>
              </div>
            </div>

            <!-- CMS PÁGINA 6: CONTACTO & GLOBAL -->
            <div id="cms-page-contacto" class="cms-page-box hidden space-y-4 p-5 rounded-2xl bg-slate-900 border border-slate-800">
              <h2 class="text-xs font-mono font-bold text-emerald-400 uppercase tracking-wider">Contacto, Canales Oficiales y Header/Footer Global</h2>
              
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Central Telefónica</label>
                  <input type="text" id="c_con_phone" value="+51 963 895 085" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Número de WhatsApp Cotizaciones</label>
                  <input type="text" id="c_con_wa" value="51963895085" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white font-mono" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Correo Institucional</label>
                  <input type="email" id="c_con_email" value="contacto@servitotales.com" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white" />
                </div>
                <div>
                  <label class="block text-xs font-bold text-slate-300 mb-1">Cobertura Geográfica</label>
                  <input type="text" id="c_con_cov" value="Entrega en Obra a Nivel Nacional" class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white" />
                </div>
                <div class="sm:col-span-2">
                  <label class="block text-xs font-bold text-slate-300 mb-1">Texto de Barra Superior (Top Docked Bar)</label>
                  <input type="text" id="c_con_topbar" value="SGC ISO 9001:2015 CERTIFICADO • Servicios Totales del Perú S.A.C." class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white" />
                </div>
                <div class="sm:col-span-2">
                  <label class="block text-xs font-bold text-slate-300 mb-1">Texto de Derechos de Autor (Footer Copyright)</label>
                  <input type="text" id="c_con_copy" value="© 2026 Servicios Totales del Perú S.A.C. Todos los derechos reservados. SGC ISO 9001:2015." class="w-full px-3 py-2 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white" />
                </div>
              </div>
            </div>

            <div class="flex items-center justify-between pt-2">
              <span id="cms-success-msg" class="hidden text-xs font-bold text-emerald-400 flex items-center gap-1.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                <span>¡Cambios de texto guardados y actualizados con éxito!</span>
              </span>

              <button
                type="submit"
