---
import '../styles/global.css';
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Panel de Administración & CMS | SERVITOTALES S.A.C.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'dark';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-[var(--bg-main)] text-[var(--text-primary)] antialiased min-h-screen selection:bg-[#DC2626] selection:text-white font-sans flex flex-col">
    
    <!-- Standalone Admin Top Navigation Bar (NO PUBLIC NAVBAR) -->
    <header class="sticky top-0 z-50 w-full px-4 sm:px-8 py-3.5 border-b border-[var(--border-subtle)] bg-[var(--bg-surface)] backdrop-blur-md flex items-center justify-between gap-4">
      <div class="flex items-center gap-4">
        <a href="/admin" class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-[#DC2626] to-[#991B1B] text-white font-black flex items-center justify-center text-lg shadow-md">
            ST
          </div>
          <div class="flex flex-col">
            <span class="text-base font-black tracking-wider text-[var(--text-primary)] font-heading leading-tight">
              SERVI<span class="text-[#DC2626]">TOTALES</span>
            </span>
            <span class="text-[9px] font-mono font-bold text-amber-500 uppercase tracking-widest">
              PANEL DE CONTROL & CMS
            </span>
          </div>
        </a>

        <div class="hidden md:flex items-center gap-2 pl-4 border-l border-[var(--border-subtle)] text-xs text-[var(--text-secondary)] font-mono">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>SGC ISO 9001:2015 ACTIVO</span>
        </div>
      </div>

      <div class="flex items-center gap-3">
        <!-- View Public Site Button -->
        <a
          href="/"
          target="_blank"
          class="px-3 py-2 rounded-xl text-xs font-bold text-[var(--text-secondary)] hover:text-[var(--text-primary)] hover:bg-[var(--bg-main)] transition flex items-center gap-1.5 border border-[var(--border-subtle)]"
          title="Ver Sitio Web Público"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          <span class="hidden sm:inline">Ver Sitio Web</span>
        </a>

        <!-- Admin User Badge -->
        <div class="hidden lg:flex items-center gap-2 px-3 py-1.5 rounded-xl bg-[var(--bg-main)] border border-[var(--border-subtle)] text-xs">
          <span class="w-2 h-2 rounded-full bg-blue-500"></span>
          <span class="font-mono text-[11px] font-bold text-[var(--text-primary)]" id="admin-user-display">admin@servitotales.com</span>
        </div>

        <!-- Logout Button -->
        <button
          type="button"
          id="btn-admin-logout"
          class="px-3.5 py-2 rounded-xl bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white transition text-xs font-bold border border-red-500/20 flex items-center gap-1.5 cursor-pointer"
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"></path></svg>
          <span>Salir</span>
        </button>
      </div>
    </header>

    <!-- Admin Workspace -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 space-y-8">
      
      <!-- Top Overview Metrics -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
        <div class="p-5 rounded-3xl industrial-card shadow-md border-l-4 border-blue-500 bg-[var(--bg-surface)]">
          <span class="text-xs font-mono font-bold text-slate-400 uppercase block">Cotizaciones Web</span>
          <span class="text-3xl font-black text-[var(--text-primary)] font-heading" id="metric-leads">12</span>
          <span class="text-[11px] text-emerald-500 font-bold block mt-1">+3 solicitudes hoy</span>
        </div>

        <div class="p-5 rounded-3xl industrial-card shadow-md border-l-4 border-[#DC2626] bg-[var(--bg-surface)]">
          <span class="text-xs font-mono font-bold text-slate-400 uppercase block">Flota en Operación</span>
          <span class="text-3xl font-black text-[var(--text-primary)] font-heading">28 / 34</span>
          <span class="text-[11px] text-blue-500 font-bold block mt-1">82% Flota Activa</span>
        </div>

        <div class="p-5 rounded-3xl industrial-card shadow-md border-l-4 border-amber-500 bg-[var(--bg-surface)]">
          <span class="text-xs font-mono font-bold text-slate-400 uppercase block">Productos & Lotes</span>
          <span class="text-3xl font-black text-[var(--text-primary)] font-heading" id="metric-products">29</span>
          <span class="text-[11px] text-amber-500 font-bold block mt-1">Con fotos asignadas</span>
        </div>

        <div class="p-5 rounded-3xl industrial-card shadow-md border-l-4 border-emerald-500 bg-[var(--bg-surface)]">
          <span class="text-xs font-mono font-bold text-slate-400 uppercase block">SGC ISO 9001:2015</span>
          <span class="text-3xl font-black text-emerald-500 font-heading">100%</span>
          <span class="text-[11px] text-emerald-500 font-bold block mt-1">Auditoría al día</span>
        </div>
      </div>

      <!-- Main Tabbed Panel Box -->
      <div class="p-6 sm:p-8 rounded-3xl industrial-card shadow-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-6">
        
        <!-- Navigation Tabs -->
        <div class="flex flex-wrap items-center justify-between gap-4 border-b border-[var(--border-subtle)] pb-4">
          <div class="flex flex-wrap items-center gap-2" id="admin-main-tabs">
            <button
              type="button"
              data-tab="cms"
              class="tab-btn px-4 py-2.5 rounded-2xl text-xs font-bold transition-all duration-200 cursor-pointer bg-[#DC2626] text-white shadow-md"
            >
              📝 Editor de Textos & CMS
            </button>
            <button
              type="button"
              data-tab="products"
              class="tab-btn px-4 py-2.5 rounded-2xl text-xs font-bold transition-all duration-200 cursor-pointer bg-[var(--bg-main)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
            >
              🖼️ Gestor de Productos & Fotos
            </button>
            <button
              type="button"
              data-tab="leads"
              class="tab-btn px-4 py-2.5 rounded-2xl text-xs font-bold transition-all duration-200 cursor-pointer bg-[var(--bg-main)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
            >
              📋 Mesa de Cotizaciones
            </button>
            <button
              type="button"
              data-tab="fleet"
              class="tab-btn px-4 py-2.5 rounded-2xl text-xs font-bold transition-all duration-200 cursor-pointer bg-[var(--bg-main)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]"
            >
              🚜 Flota de Maquinaria
            </button>
          </div>

          <button
            type="button"
            id="btn-export-csv"
            class="px-4 py-2 rounded-xl bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-xs font-bold hover:bg-emerald-500 hover:text-white transition flex items-center gap-1.5 border border-emerald-500/30 cursor-pointer"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
            <span>Exportar Reporte CSV</span>
          </button>
        </div>

        <!-- 1. TAB CMS: EDITOR DE CONTENIDO Y TEXTOS DEL SITIO -->
        <div id="tab-cms" class="tab-panel space-y-6">
          <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-3">
            <div>
              <h2 class="text-xl font-black text-[var(--text-primary)] font-heading">
                Gestor de Textos y Contenidos de la Web (CMS)
              </h2>
              <p class="text-xs text-[var(--text-secondary)]">
                Modifica los textos principales del portal, teléfonos, correos y consignas de marca.
              </p>
            </div>
            <span class="text-xs font-mono font-bold text-amber-500">Auto-Guardado Local</span>
          </div>

          <form id="cms-editor-form" class="space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <!-- Hero Headline -->
              <div class="md:col-span-2 space-y-2">
                <label for="cms_hero_title" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider">
                  Titular Principal del Hero (Portada) *
                </label>
                <input
                  type="text"
                  id="cms_hero_title"
                  value="Potenciamos tus operaciones y proyectos con Maquinaria y Suministros"
                  class="w-full px-4 py-3 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] text-sm focus:outline-none focus:border-[#DC2626] font-bold"
                />
              </div>

              <!-- Hero Subtitle -->
              <div class="md:col-span-2 space-y-2">
                <label for="cms_hero_desc" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider">
                  Descripción / Bajada del Hero *
                </label>
                <textarea
                  id="cms_hero_desc"
                  rows="2"
                  class="w-full px-4 py-3 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] text-sm focus:outline-none focus:border-[#DC2626]"
                >Aliado estratégico para construcción, minería y obras viales a nivel nacional. Flota moderna con operadores homologados, mantenimiento 24/7 y entrega directa en obra.</textarea>
              </div>

              <!-- Phone & WhatsApp -->
              <div class="space-y-2">
                <label for="cms_phone" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider">
                  Teléfono / WhatsApp Oficial *
                </label>
                <input
                  type="text"
                  id="cms_phone"
                  value="+51 963 895 085"
                  class="w-full px-4 py-3 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] text-sm focus:outline-none focus:border-[#DC2626]"
                />
              </div>

              <!-- Corporate Email -->
              <div class="space-y-2">
                <label for="cms_email" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider">
                  Correo Institucional *
                </label>
                <input
                  type="email"
                  id="cms_email"
                  value="contacto@servitotales.com"
                  class="w-full px-4 py-3 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] text-sm focus:outline-none focus:border-[#DC2626]"
                />
              </div>

              <!-- ISO 9001 Badge Text -->
              <div class="space-y-2">
                <label for="cms_iso" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider">
                  Texto del Sello de Calidad *
                </label>
                <input
                  type="text"
                  id="cms_iso"
                  value="SGC ISO 9001:2015 CERTIFICADO"
                  class="w-full px-4 py-3 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] text-sm focus:outline-none focus:border-[#DC2626]"
                />
              </div>

              <!-- Location / Coverage -->
              <div class="space-y-2">
                <label for="cms_coverage" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider">
                  Cobertura y Alcance *
                </label>
                <input
                  type="text"
                  id="cms_coverage"
                  value="Entrega en Obra a Nivel Nacional"
                  class="w-full px-4 py-3 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] text-sm focus:outline-none focus:border-[#DC2626]"
                />
              </div>
            </div>

            <div class="flex items-center justify-between pt-4 border-t border-[var(--border-subtle)]">
              <span id="cms-saved-msg" class="hidden text-xs font-bold text-emerald-500">
                ✅ Cambios de texto guardados exitosamente.
              </span>

              <button
                type="submit"
                class="px-8 py-3.5 rounded-2xl bg-[#DC2626] hover:bg-[#B91C1C] text-white text-xs font-black uppercase tracking-wider shadow-lg hover:-translate-y-0.5 transition-all cursor-pointer ml-auto"
              >
                Guardar Cambios de Texto
              </button>
            </div>
          </form>
        </div>

        <!-- 2. TAB PRODUCTS: GESTOR DE PRODUCTOS Y FOTOS -->
        <div id="tab-products" class="tab-panel hidden space-y-6">
          <div class="flex flex-wrap items-center justify-between gap-4 border-b border-[var(--border-subtle)] pb-3">
            <div>
              <h2 class="text-xl font-black text-[var(--text-primary)] font-heading">
                Catálogo de Productos & Fotografías
              </h2>
              <p class="text-xs text-[var(--text-secondary)]">
                Agrega nuevos productos, modifica especificaciones y asigna imágenes personalizadas.
              </p>
            </div>

            <button
              type="button"
              id="btn-open-new-product-modal"
              class="px-4 py-2.5 rounded-2xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold shadow transition flex items-center gap-1.5 cursor-pointer"
            >
              <span>+ Agregar Nuevo Producto</span>
            </button>
          </div>

          <!-- Product Cards Grid with Photos -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" id="admin-products-grid">
            <!-- Dynamic Products Injected via JS -->
          </div>
        </div>

        <!-- 3. TAB LEADS: MESA DE COTIZACIONES -->
        <div id="tab-leads" class="tab-panel hidden space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-black text-[var(--text-primary)] font-heading">
              Solicitudes Recientes de Cotización Técnica
            </h2>
            <span class="text-xs text-[var(--text-secondary)]">Tiempo real</span>
          </div>

          <div class="overflow-x-auto rounded-2xl border border-[var(--border-subtle)]">
            <table class="w-full text-left text-xs text-[var(--text-secondary)]">
              <thead class="bg-[var(--bg-main)] text-[11px] uppercase font-mono font-bold text-[var(--text-primary)] border-b border-[var(--border-subtle)]">
                <tr>
                  <th class="p-3.5">Fecha</th>
                  <th class="p-3.5">Cliente / Empresa</th>
                  <th class="p-3.5">División</th>
                  <th class="p-3.5">Ubicación Obra</th>
                  <th class="p-3.5">Contacto</th>
                  <th class="p-3.5">Estado</th>
                  <th class="p-3.5 text-right">Respuesta</th>
                </tr>
              </thead>
              <tbody id="leads-table-body" class="divide-y divide-[var(--border-subtle)] bg-[var(--bg-surface)]">
                <!-- Injected via JS -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- 4. TAB FLEET: FLOTA DE MAQUINARIA -->
        <div id="tab-fleet" class="tab-panel hidden space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-xl font-black text-[var(--text-primary)] font-heading">
              Control de Flota y Telemetría
            </h2>
            <span class="text-xs text-[var(--text-secondary)]">Monitoreo de equipos pesados y trackless</span>
          </div>

          <div class="overflow-x-auto rounded-2xl border border-[var(--border-subtle)]">
            <table class="w-full text-left text-xs text-[var(--text-secondary)]">
              <thead class="bg-[var(--bg-main)] text-[11px] uppercase font-mono font-bold text-[var(--text-primary)] border-b border-[var(--border-subtle)]">
                <tr>
                  <th class="p-3.5">Cód. Equipo</th>
                  <th class="p-3.5">Modelo / Tipo</th>
                  <th class="p-3.5">Categoría</th>
                  <th class="p-3.5">Ubicación Mina</th>
                  <th class="p-3.5">Horómetro</th>
                  <th class="p-3.5">Estado</th>
                </tr>
              </thead>
              <tbody id="fleet-table-body" class="divide-y divide-[var(--border-subtle)] bg-[var(--bg-surface)]">
                <!-- Injected via JS -->
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </main>

    <!-- Clean Standalone Admin Footer -->
    <footer class="w-full py-4 px-6 border-t border-[var(--border-subtle)] text-center text-xs text-slate-500 font-mono">
      Servicios Totales del Perú S.A.C. • Panel de Control & CMS v2.4 • Sistema de Gestión de Calidad ISO 9001:2015
    </footer>

    <script>
      // Auth Guard
      if (localStorage.getItem('servitotales_admin_auth') !== 'true') {
        window.location.href = '/login';
      }

      document.getElementById('btn-admin-logout')?.addEventListener('click', () => {
        localStorage.removeItem('servitotales_admin_auth');
        window.location.href = '/login';
      });

      // Tab Switching
      const tabBtns = document.querySelectorAll('#admin-main-tabs .tab-btn');
      const tabPanels = document.querySelectorAll('.tab-panel');

      tabBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          const tab = btn.getAttribute('data-tab');

          tabBtns.forEach(b => {
            b.className = 'tab-btn px-4 py-2.5 rounded-2xl text-xs font-bold transition-all duration-200 cursor-pointer bg-[var(--bg-main)] text-[var(--text-secondary)] hover:text-[var(--text-primary)]';
          });
          btn.className = 'tab-btn px-4 py-2.5 rounded-2xl text-xs font-bold transition-all duration-200 cursor-pointer bg-[#DC2626] text-white shadow-md';

          tabPanels.forEach(p => p.classList.add('hidden'));
          const activePanel = document.getElementById('tab-' + tab);
          if (activePanel) activePanel.classList.remove('hidden');
        });
      });

      // Dynamic Products Store
      let products = [
        { id: 1, name: "Excavadora sobre Orugas CAT 320 / 336", division: "Maquinaria Pesada", brand: "Caterpillar", specs: "Peso: 22-38 Tn • Cuchara: 1.2 - 2.5 m³", image: "https://images.unsplash.com/photo-1579829366248-204fe8413f31?auto=format&fit=crop&w=600&q=80" },
        { id: 2, name: "Cargador Frontal CAT 950 / 966", division: "Maquinaria Pesada", brand: "Caterpillar", specs: "Capacidad: 3.5 - 5.0 m³ • Potencia: 230-300 HP", image: "https://images.unsplash.com/photo-1581094288338-2314dddb7ece?auto=format&fit=crop&w=600&q=80" },
        { id: 3, name: "Jumbo Electrohidráulico de Perforación", division: "Minería Trackless", brand: "Sandvik / Epiroc", specs: "1 y 2 Brazos • Cobertura: 35-65 m²", image: "https://images.unsplash.com/photo-1578328819058-b69f3a3b0f6b?auto=format&fit=crop&w=600&q=80" },
        { id: 4, name: "Respiradores de Medio Rostro Serie 6200", division: "Seguridad & EPP", brand: "3M", specs: "Norma NIOSH / OSHA P100", image: "https://images.unsplash.com/photo-1584634731339-252c581abfc5?auto=format&fit=crop&w=600&q=80" },
        { id: 5, name: "Pernos Estructurales Grado A325", division: "Ferretería & Suministros", brand: "Servitotales", specs: "Acabado Negro / Galvanizado 3/4x3", image: "https://images.unsplash.com/photo-1586864387967-d02ef85d93e8?auto=format&fit=crop&w=600&q=80" },
        { id: 6, name: "Arnés de Seguridad Integral 4 Anillos", division: "Seguridad & EPP", brand: "Capital Safety", specs: "Certificación ANSI Z359.11", image: "https://images.unsplash.com/photo-1504307651254-35680f356dfd?auto=format&fit=crop&w=600&q=80" }
      ];

      function renderAdminProducts() {
        const grid = document.getElementById('admin-products-grid');
        if (!grid) return;
        grid.innerHTML = products.map(prod => `
          <div class="rounded-3xl industrial-card overflow-hidden border border-[var(--border-subtle)] bg-[var(--bg-main)] flex flex-col justify-between group">
            <div class="relative h-44 w-full overflow-hidden bg-slate-900">
              <img src="${prod.image}" alt="${prod.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded-lg bg-black/70 backdrop-blur-md text-[10px] font-mono font-bold text-white border border-white/10">
                ${prod.division}
              </span>
            </div>
            <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
              <div class="space-y-1">
                <span class="text-[10px] font-mono font-bold text-red-500 uppercase">${prod.brand}</span>
                <h3 class="text-sm font-bold text-[var(--text-primary)] leading-tight">${prod.name}</h3>
                <p class="text-xs text-[var(--text-secondary)] line-clamp-2">${prod.specs}</p>
              </div>
              <div class="pt-3 border-t border-[var(--border-subtle)] flex items-center gap-2">
                <button
                  type="button"
                  onclick="editProductPhoto(${prod.id})"
                  class="flex-1 py-2 px-3 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-xs font-bold text-center transition"
                >
                  📷 Cambiar Foto
                </button>
                <button
                  type="button"
                  onclick="deleteProduct(${prod.id})"
                  class="py-2 px-3 rounded-xl bg-red-500/10 text-red-500 hover:bg-red-500 hover:text-white text-xs font-bold transition border border-red-500/20"
                >
                  🗑️
                </button>
              </div>
            </div>
          </div>
        `).join("");
      }

      window.editProductPhoto = function(id: number) {
        const prod = products.find(p => p.id === id);
        if (!prod) return;
        const newUrl = prompt('Ingresa la nueva URL de la imagen para ' + prod.name + ':', prod.image);
        if (newUrl && newUrl.trim()) {
          prod.image = newUrl.trim();
          renderAdminProducts();
          alert('Imagen actualizada con éxito para ' + prod.name);
        }
      };

      window.deleteProduct = function(id: number) {
        if (confirm('¿Deseas eliminar este producto del panel?')) {
          products = products.filter(p => p.id !== id);
          renderAdminProducts();
        }
      };

      document.getElementById('btn-open-new-product-modal')?.addEventListener('click', () => {
        const name = prompt('Nombre del producto / equipo:');
        const division = prompt('División (Maquinaria Pesada / Seguridad & EPP / Ferretería):', 'Maquinaria Pesada');
        const brand = prompt('Marca (ej. Caterpillar, 3M, Milwaukee):', 'Caterpillar');
        const specs = prompt('Especificaciones técnicas:');
        const image = prompt('URL de la fotografía del producto:', 'https://images.unsplash.com/photo-1579829366248-204fe8413f31?auto=format&fit=crop&w=600&q=80');

        if (name && division) {
          products.unshift({
            id: Date.now(),
            name: name,
            division: division || 'Maquinaria Pesada',
            brand: brand || 'Servitotales',
            specs: specs || 'Especificaciones bajo pedido.',
            image: image || 'https://images.unsplash.com/photo-1579829366248-204fe8413f31?auto=format&fit=crop&w=600&q=80'
          });
          renderAdminProducts();
          alert('Producto ' + name + ' registrado exitosamente con su fotografía.');
        }
      });

      renderAdminProducts();

      // CMS Form Save
      document.getElementById('cms-editor-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const savedMsg = document.getElementById('cms-saved-msg');
        if (savedMsg) {
          savedMsg.classList.remove('hidden');
          setTimeout(() => savedMsg.classList.add('hidden'), 3500);
        }
      });

      // Leads Rendering
      const leads = [
        { date: '29/08/2026', client: 'Ing. Carlos Mendoza', company: 'Consorcio Vial Junín', division: 'Maquinaria Pesada', location: 'Huancayo - Mina Yauli', phone: '+51 987 654 321', status: 'Pendiente' },
        { date: '29/08/2026', client: 'Ing. Lucía Paredes', company: 'Minera Las Cumbres SAC', division: 'Seguridad & EPP', location: 'Arequipa - Cerro Verde', phone: '+51 965 412 879', status: 'En Evaluación' },
        { date: '28/08/2026', client: 'Ing. Roberto Silva', company: 'Constructora del Sur EIRL', division: 'Ferretería & Suministros', location: 'Cusco - Espinar', phone: '+51 974 582 143', status: 'Cotizado' }
      ];

      const leadsBody = document.getElementById('leads-table-body');
      if (leadsBody) {
        leadsBody.innerHTML = leads.map(l => `
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition">
            <td class="p-3.5 font-mono text-[11px] text-slate-400">${l.date}</td>
            <td class="p-3.5"><strong class="text-[var(--text-primary)] block">${l.client}</strong><span class="text-[10px] text-slate-400 font-mono">${l.company}</span></td>
            <td class="p-3.5 font-semibold text-[var(--text-primary)]">${l.division}</td>
            <td class="p-3.5 text-slate-400">${l.location}</td>
            <td class="p-3.5 font-mono text-[11px] text-blue-500">${l.phone}</td>
            <td class="p-3.5"><span class="px-2.5 py-0.5 rounded-full border text-[10px] font-bold bg-blue-500/10 text-blue-500 border-blue-500/30">${l.status}</span></td>
            <td class="p-3.5 text-right"><button type="button" onclick="window.open('https://wa.me/51963895085', '_blank')" class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-600 text-[10px] font-bold border border-emerald-500/30 hover:bg-emerald-500 hover:text-white transition">WhatsApp</button></td>
          </tr>
        `).join("");
      }

      // Fleet Rendering
      const fleet = [
        { code: 'EXC-01', model: 'Excavadora CAT 336D (36 Tn)', cat: 'Línea Amarilla', loc: 'Mina Toromocho - Junín', hrs: '4,120 hrs', status: 'En Operación' },
        { code: 'EXC-02', model: 'Excavadora Komatsu PC350LC', cat: 'Línea Amarilla', loc: 'Patio Central Lima', hrs: '1,890 hrs', status: 'Disponible' },
        { code: 'JMB-01', model: 'Jumbo Sandvik DD321 (2 Brazos)', cat: 'Minería Trackless', loc: 'Mina Yauli - Pasco', hrs: '2,450 hrs', status: 'En Operación' }
      ];

      const fleetBody = document.getElementById('fleet-table-body');
      if (fleetBody) {
        fleetBody.innerHTML = fleet.map(f => `
          <tr class="hover:bg-slate-50 dark:hover:bg-slate-800/50 transition">
            <td class="p-3.5 font-mono font-bold text-red-500">${f.code}</td>
            <td class="p-3.5 font-bold text-[var(--text-primary)]">${f.model}</td>
            <td class="p-3.5 text-slate-400 font-mono text-[11px]">${f.cat}</td>
            <td class="p-3.5 text-slate-400">${f.loc}</td>
            <td class="p-3.5 font-mono text-[11px] text-[var(--text-primary)]">${f.hrs}</td>
            <td class="p-3.5"><span class="px-2.5 py-0.5 rounded-full border text-[10px] font-bold bg-blue-500/10 text-blue-500 border-blue-500/30">${f.status}</span></td>
          </tr>
        `).join("");
      }

      // Export CSV
      document.getElementById('btn-export-csv')?.addEventListener('click', () => {
        const csvContent = "data:text/csv;charset=utf-8," 
          + "Fecha,Cliente,Empresa,Division,Ubicacion,Telefono,Estado\n"
          + leads.map(e => `"${e.date}","${e.client}","${e.company}","${e.division}","${e.location}","${e.phone}","${e.status}"`).join("\n");
        
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", "servitotales_reporte.csv");
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      });
    </script>
  </body>
</html>
