        { id: 206, category: "epp", division: "Seguridad & EPP", brand: "MSA V-Gard", name: "Cascos de Seguridad Dieléctricos Tipo I y II", specs: "ANSI Z89.1 Clase E & G con Barboquejo", image: "https://images.unsplash.com/photo-1578873375972-04b321a4f027?auto=format&fit=crop&w=600&q=80" },
