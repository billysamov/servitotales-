        { id: 306, category: "suministros", division: "Ferretería & Suministros", brand: "Industrial", name: "Pinturas Epóxicas y Poliuretano Alto Sólidos", specs: "Resistencia Química y Anticorrosiva", image: "https://images.unsplash.com/photo-1589939705384-5185137a7f0f?auto=format&fit=crop&w=600&q=80" }
      ];

      let currentFilter = "all";

      function renderCatalog() {
        const container = document.getElementById('catalog-products-container');
        if (!container) return;

        const q = (document.getElementById('catalog-quick-search') as HTMLInputElement)?.value.toLowerCase().trim() || "";
        
        const filtered = allProducts.filter(p => {
          const matchDiv = currentFilter === "all" || p.category === currentFilter;
          const matchQuery = !q || p.name.toLowerCase().includes(q) || p.brand.toLowerCase().includes(q) || p.specs.toLowerCase().includes(q);
          return matchDiv && matchQuery;
        });

        const badge = document.getElementById('total-catalog-badge');
        if (badge) badge.textContent = `${allProducts.length} Productos`;

        if (filtered.length === 0) {
          container.innerHTML = `<div class="col-span-full p-8 text-center text-xs text-slate-500 font-mono">No se encontraron productos coincidentes.</div>`;
          return;
        }

        container.innerHTML = filtered.map(item => `
          <div class="p-3 rounded-2xl bg-slate-900 border border-slate-800 flex flex-col justify-between group hover:border-slate-700 transition">
            <div class="relative h-36 w-full rounded-xl overflow-hidden bg-slate-950 mb-3">
              <img src="${item.image}" alt="${item.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              <span class="absolute top-2 left-2 px-2 py-0.5 rounded-md bg-black/80 backdrop-blur-md text-[9px] font-mono font-bold text-white border border-white/10 uppercase">
                ${item.brand}
              </span>
            </div>
            <div class="space-y-1 flex-1">
              <span class="text-[9px] font-mono font-bold text-red-400 uppercase block">${item.division}</span>
              <h3 class="text-xs font-bold text-white line-clamp-1">${item.name}</h3>
              <p class="text-[11px] text-slate-400 line-clamp-2">${item.specs}</p>
            </div>
            <div class="pt-3 mt-3 border-t border-slate-800 flex items-center gap-2">
              <button
                type="button"
                onclick="changeProductPhoto(${item.id})"
                class="flex-1 py-1.5 px-2.5 rounded-lg bg-blue-600/20 text-blue-400 hover:bg-blue-600 hover:text-white text-[11px] font-bold transition flex items-center justify-center gap-1.5 border border-blue-500/30 cursor-pointer"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                <span>Cambiar Foto</span>
              </button>
              <button
                type="button"
                onclick="deleteProductItem(${item.id})"
                class="p-1.5 rounded-lg bg-red-500/10 text-red-400 hover:bg-red-600 hover:text-white text-[11px] font-bold transition border border-red-500/20 cursor-pointer"
                title="Eliminar Producto"
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
              </button>
            </div>
          </div>
        `).join('');
      }

      window.changeProductPhoto = function(id: number) {
        const prod = allProducts.find(p => p.id === id);
        if (!prod) return;
        const newUrl = prompt('Ingresa la nueva URL de la imagen para ' + prod.name + ':', prod.image);
        if (newUrl && newUrl.trim()) {
          prod.image = newUrl.trim();
          renderCatalog();
          alert('Fotografía actualizada exitosamente para: ' + prod.name);
        }
      };

      window.deleteProductItem = function(id: number) {
        if (confirm('¿Deseas retirar este producto del catálogo?')) {
          allProducts = allProducts.filter(p => p.id !== id);
          renderCatalog();
        }
      };

      // Add New Product
      document.getElementById('btn-new-product')?.addEventListener('click', () => {
        const name = prompt('Nombre del producto o modelo:');
        const cat = prompt('Categoría (maquinaria / epp / suministros):', 'maquinaria');
        const brand = prompt('Marca del producto:', 'Caterpillar');
        const specs = prompt('Especificaciones técnicas clave:');
        const img = prompt('URL de la fotografía del producto:', 'https://images.unsplash.com/photo-1579829366248-204fe8413f31?auto=format&fit=crop&w=600&q=80');

        if (name) {
          allProducts.unshift({
            id: Date.now(),
            category: cat || 'maquinaria',
            division: (cat === 'epp' ? 'Seguridad & EPP' : (cat === 'suministros' ? 'Ferretería & Suministros' : 'Maquinaria Pesada')),
            brand: brand || 'Servitotales',
            name: name,
            specs: specs || 'Especificación según requerimiento.',
            image: img || 'https://images.unsplash.com/photo-1579829366248-204fe8413f31?auto=format&fit=crop&w=600&q=80'
          });
          renderCatalog();
          alert('Producto ' + name + ' registrado exitosamente con su fotografía.');
        }
      });

      // Filter Tabs
      const divBtns = document.querySelectorAll('#division-filter-tabs .div-tab-btn');
      divBtns.forEach(btn => {
        btn.addEventListener('click', () => {
          currentFilter = btn.getAttribute('data-div') || 'all';
          divBtns.forEach(b => {
            b.className = 'div-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition cursor-pointer';
          });
          btn.className = 'div-tab-btn px-3 py-1.5 rounded-lg text-xs font-bold text-white bg-red-600 transition cursor-pointer';
          renderCatalog();
        });
      });

      document.getElementById('catalog-quick-search')?.addEventListener('input', () => renderCatalog());
      renderCatalog();

      // Real Leads Store (No fake mock placeholders)
      const realLeads = [
        { date: '29/08/2026', client: 'Ing. Marco Paredes', company: 'Consorcio Minero', division: 'Maquinaria Pesada', location: 'Mina Las Bambas', phone: '+51 963 895 085', status: 'Nuevo' }
      ];

      function renderLeads() {
        const tbody = document.getElementById('leads-table-rows');
        if (!tbody) return;
        tbody.innerHTML = realLeads.map(l => `
          <tr class="hover:bg-slate-800/40 transition">
            <td class="p-3 font-mono text-[11px] text-slate-400">${l.date}</td>
            <td class="p-3"><strong class="text-white block text-xs">${l.client}</strong><span class="text-[10px] text-slate-400 font-mono">${l.company}</span></td>
            <td class="p-3 font-semibold text-white text-xs">${l.division}</td>
            <td class="p-3 text-slate-400 text-xs">${l.location}</td>
            <td class="p-3 font-mono text-[11px] text-blue-400">${l.phone}</td>
            <td class="p-3"><span class="px-2 py-0.5 rounded-full border text-[10px] font-bold bg-blue-500/10 text-blue-400 border-blue-500/30">${l.status}</span></td>
            <td class="p-3 text-right">
              <button
                type="button"
                onclick="window.open('https://wa.me/51963895085?text=' + encodeURIComponent('Hola ${l.client} de ${l.company}, le contactamos de Servitotales respecto a su cotización.'), '_blank')"
                class="px-2.5 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 hover:bg-emerald-600 hover:text-white transition text-[10px] font-bold border border-emerald-500/30 cursor-pointer"
              >
                WhatsApp
              </button>
            </td>
          </tr>
        `).join('');
      }
      renderLeads();

      // Download CSV
      document.getElementById('btn-download-leads')?.addEventListener('click', () => {
        const csvContent = "data:text/csv;charset=utf-8," 
          + "Fecha,Cliente,Empresa,Division,Ubicacion,Telefono,Estado\n"
          + realLeads.map(e => `"${e.date}","${e.client}","${e.company}","${e.division}","${e.location}","${e.phone}","${e.status}"`).join("\n");
        
        const encodedUri = encodeURI(csvContent);
        const link = document.createElement("a");
        link.setAttribute("href", encodedUri);
        link.setAttribute("download", "servitotales_cotizaciones_oficiales.csv");
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
      });
    </script>
  </body>
</html>
