---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Compromiso Social con Propósito | SERVITOTALES S.A.C. y ONG Corazones Felices"
  description="Conoce el compromiso social de SERVITOTALES S.A.C. Cada proyecto y suministro comercial es parte de una causa mayor: apoyar activamente a la ONG Corazones Felices sembrando para la generación líder del futuro."
>
  <!-- Atmospheric Hero Section with Dedicated Image -->
  <section class="relative py-20 lg:py-28 border-b border-slate-800/80 bg-[#050A14] overflow-hidden text-white">
    <div class="absolute inset-0 w-full h-full z-0 overflow-hidden pointer-events-none select-none">
      <img
        src="/images/compromiso/corazones-felices-portada.webp"
        alt="Compromiso Social Servitotales con la niñez y las comunidades"
        loading="eager"
        decoding="async"
        class="w-full h-full object-cover opacity-25 contrast-110 saturate-110"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#050A14] via-[#050A14]/90 to-[#050A14]/70"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#050A14] via-transparent to-transparent"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-5" id="social-hero">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-600/20 border border-red-500/35 text-red-400 font-mono text-[11px] font-bold tracking-wider uppercase">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
          <span>COMPROMISO SOCIAL Y PROPÓSITO CORPORATIVO</span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-black text-white font-heading leading-tight" id="social-title">
          Construyendo Oportunidades, Sembrando Futuro
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal" id="social-desc">
          En <strong class="text-white font-bold">Servicios Totales del Perú S.A.C.</strong> creemos firmemente que el éxito empresarial solo tiene sentido cuando genera un impacto positivo en las personas. Cada solución de abastecimiento, equipo de protección y servicio que brindamos forma parte de un propósito mayor: <strong class="text-amber-400">transformar realidades y respaldar a quienes más lo necesitan</strong>.
        </p>

        <!-- Callout Banner -->
        <div class="p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-red-950/60 to-slate-900/80 border border-red-500/30 backdrop-blur-md">
          <p class="text-xs sm:text-sm text-slate-200 leading-relaxed">
            🤝 <strong class="text-white">Al unirte y trabajar con Servitotales</strong>, tu empresa no solo adquiere suministros y maquinaria de clase mundial con certificación ISO 9001; también se convierte en <strong class="text-amber-300">parte activa y directa del apoyo solidario a la niñez peruana</strong> a través de nuestra alianza con la ONG Corazones Felices.
          </p>
        </div>

        <!-- Direct Action Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-3">
          <a
            href="#alianza-corazones-felices"
            class="px-6 py-3.5 rounded-2xl bg-[#DC2626] hover:bg-[#B91C1C] text-white font-black text-xs uppercase tracking-wider transition shadow-lg flex items-center gap-2 hover:-translate-y-0.5 cursor-pointer"
          >
            <span>Ver Alianza con Corazones Felices</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path></svg>
          </a>

          <a
            href="/contacto"
            class="px-6 py-3.5 rounded-2xl bg-slate-900/80 hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-wider border border-slate-700 transition backdrop-blur-md"
          >
            <span>Cotización</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 1. ALIANZA DESTACADA: ONG CORAZONES FELICES -->
  <!-- ========================================================================= -->
  <section id="alianza-corazones-felices" class="py-16 lg:py-24 border-b border-[var(--border-subtle)] bg-[var(--bg-main)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-12">
      
      <!-- Section Header -->
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
        <div class="max-w-2xl space-y-3">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-500/15 border border-red-500/30 text-[#DC2626] dark:text-red-400 font-mono text-[11px] font-bold uppercase tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
            <span>ALIANZA ESTRATÉGICA SOCIAL ACTIVA</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-black text-[var(--text-primary)] font-heading leading-tight">
            Sembrando para la Generación Líder del Futuro
          </h2>
          <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
            Iniciamos nuestro programa continuo de apoyo comunitario uniendo esfuerzos con <strong class="text-[var(--text-primary)]">Corazones Felices</strong>, una organización sin fines de lucro dedicada a proteger, nutrir y educar a niños y familias en situación de vulnerabilidad social en el Perú.
          </p>
        </div>

        <a
          href="https://corazonesfelices.org.pe/"
          target="_blank"
          rel="noopener noreferrer"
          class="px-5 py-3 rounded-2xl bg-[var(--bg-surface)] hover:bg-red-500/10 border border-[var(--border-subtle)] hover:border-red-500/30 text-xs font-bold text-[var(--text-primary)] transition flex items-center gap-2 shrink-0 group shadow-sm"
        >
          <span>Visitar web oficial de Corazones Felices</span>
          <svg class="w-4 h-4 text-red-500 group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
        </a>
      </div>

      <!-- Main Showcase Feature Card -->
      <div class="rounded-3xl p-6 sm:p-10 lg:p-12 bg-gradient-to-br from-slate-900 via-[#0C162A] to-slate-900 border border-slate-800 text-white shadow-2xl space-y-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
          
          <!-- NGO Branding & Message -->
          <div class="lg:col-span-7 space-y-5">
            <!-- Dual Logos Alliance Union -->
            <div class="flex flex-wrap items-center gap-3.5">
              <div class="w-14 h-14 rounded-2xl bg-white p-2 flex items-center justify-center shadow-lg border border-slate-200/80 shrink-0 hover:scale-105 transition-transform" title="SERVITOTALES S.A.C.">
                <img
                  src="/images/brand/logo-symbol.svg"
                  alt="Logo Servitotales"
                  class="w-full h-full object-contain"
                  width="56"
                  height="56"
                />
              </div>

              <div class="w-9 h-9 rounded-full bg-gradient-to-br from-amber-400 via-amber-500 to-amber-600 p-[1.5px] shadow-[0_0_15px_rgba(245,158,11,0.4)] flex items-center justify-center shrink-0">
                <div class="w-full h-full rounded-full bg-slate-950 flex items-center justify-center">
                  <svg class="w-4 h-4 text-amber-400" viewBox="0 0 640 512" fill="currentColor">
                    <path d="M624 208h-64.8l-68.5-68.5c-15.6-15.6-40.9-15.6-56.6 0l-45.3 45.3c-7.8 7.8-18.4 12.2-29.5 12.2-11.1 0-21.7-4.4-29.5-12.2l-45.3-45.3c-15.6-15.6-40.9-15.6-56.6 0L160.8 208H16c-8.8 0-16 7.2-16 16v80c0 8.8 7.2 16 16 16h64.8l88.5 88.5c15.6 15.6 40.9 15.6 56.6 0l48-48c7.8-7.8 18.4-12.2 29.5-12.2 11.1 0 21.7 4.4 29.5 12.2l48 48c15.6 15.6 40.9 15.6 56.6 0l88.5-88.5H624c8.8 0 16-7.2 16-16v-80c0-8.8-7.2-16-16-16zM320 288c-17.7 0-32-14.3-32-32s14.3-32 32-32 32 14.3 32 32-14.3 32-32 32z"/>
                  </svg>
                </div>
              </div>

              <div class="h-14 px-3.5 bg-white rounded-2xl shadow-lg border border-slate-200/80 inline-flex items-center justify-center shrink-0 hover:scale-105 transition-transform" title="ONG Corazones Felices">
                <img
                  src="/images/compromiso/corazones-felices-logo.png"
                  alt="Logo Oficial ONG Corazones Felices"
                  class="h-9 w-auto object-contain"
                  loading="eager"
                  width="180"
                  height="80"
                />
              </div>

              <div class="pl-1">
                <span class="text-[11px] font-mono text-amber-400 font-bold uppercase block tracking-wider">Alianza Social Estratégica</span>
                <h3 class="text-lg sm:text-xl font-black text-white font-heading">Servitotales & Corazones Felices</h3>
              </div>
            </div>

            <p class="text-sm sm:text-base text-slate-300 leading-relaxed">
              "Una organización que se levanta para transformar la vida de los niños frente a la crisis social y respaldar su desarrollo integral: espíritu, alma y cuerpo."
            </p>

            <!-- Synergic Value Box -->
            <div class="p-4 rounded-2xl bg-white/5 border border-white/10 space-y-2">
              <div class="flex items-center gap-2 text-xs font-mono font-bold text-amber-400 uppercase">
                <span>¿Cómo funciona la alianza con Servitotales?</span>
              </div>
              <p class="text-xs text-slate-300 leading-relaxed">
                Cada contrato corporativo, compra mayorista de EPP, adquisición de ferretería pesada o alquiler de maquinaria genera un fondo dedicado que Servitotales canaliza en apoyo logístico, donaciones y soporte directo a los programas de nutrición, salud y educación de Corazones Felices.
              </p>
            </div>
          </div>

          <!-- Portada Graphic Preview -->
          <div class="lg:col-span-5">
            <div class="relative rounded-2xl overflow-hidden border border-slate-700/60 shadow-2xl group">
              <img
                src="/images/compromiso/corazones-felices-portada.webp"
                alt="Niños beneficiarios de los programas de Corazones Felices"
                class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500"
                loading="eager"
                width="800"
                height="468"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-transparent to-transparent flex items-end p-4 sm:p-6">
                <span class="text-xs font-bold text-white tracking-wide">
                  Sembrando esperanza en niños de comunidades y zonas vulnerables
                </span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. LLAMADA A LA ACCIÓN: SÉ PARTE DEL CAMBIO -->
  <!-- ========================================================================= -->
  <section class="py-16 lg:py-20 bg-[var(--bg-main)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-8 sm:p-12 rounded-3xl industrial-card bg-gradient-to-br from-slate-900 to-[#0A1224] text-white shadow-2xl space-y-6 border border-slate-800 flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="space-y-3 max-w-2xl text-center md:text-left">
          <div class="flex items-center justify-center md:justify-start gap-2 text-amber-400 font-mono text-xs font-bold">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
            <span>ALIANZA CON PROPÓSITO SOCIAL Y CALIDAD ISO 9001</span>
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
            ¿Listo para que tu proyecto sea parte del cambio?
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Contáctanos para cotizar tus requerimientos de EPP normado, suministros industriales o maquinaria pesada y sumemos juntos valor a la comunidad.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0 w-full md:w-auto">
          <a
            href="https://wa.me/51963895085?text=Hola%20Servitotales%2C%20deseo%20solicitar%20una%20cotizaci%C3%B3n%20y%20conocer%20m%C3%A1s%20sobre%20su%20compromiso%20social."
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-[#25D366] hover:bg-[#20bd5a] text-white font-black text-xs uppercase tracking-wider text-center transition shadow-md flex items-center justify-center gap-2"
          >
            <span>WhatsApp Atención Directa</span>
          </a>
          <a
            href="/contacto"
            class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-[#DC2626] hover:bg-[#B91C1C] text-white font-black text-xs uppercase tracking-wider text-center transition shadow-md"
          >
            Cotización
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initCompromiso() {
    try {
      const hero = document.getElementById('social-hero');
      if (hero) {
        gsap.fromTo('#social-hero > *', 
          { opacity: 0, y: 25 }, 
          { opacity: 1, y: 0, duration: 0.7, stagger: 0.1, ease: 'power2.out' }
        );
      }
      ScrollTrigger.refresh();
    } catch (e) {
      console.warn('GSAP Compromiso Notice:', e);
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCompromiso);
  } else {
    initCompromiso();
  }
</script>
