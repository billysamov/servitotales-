---
import Layout from '../layouts/Layout.astro';

const pillars = [
  {
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>`,
    badge: "SST & BIENESTAR",
    badgeColor: "bg-red-500/10 text-[#DC2626] border-red-500/20",
    title: "Seguridad, Salud en el Trabajo & Cultura Preventiva",
    desc: "La integridad de las personas es nuestro valor no negociable. Implementamos rigurosos estándares de seguridad operacional en todos los frentes de obra.",
    points: [
      "Operadores y mecánicos certificados con inducción SST y homologación continua.",
      "Checklist diario pre-uso e inspecciones técnicas periódicas de maquinaria.",
      "Dotación prioritaria de EPP normado ANSI/OSHA de la más alta calidad.",
      "Cultura de prevención activa orientada al objetivo de Cero Accidentes."
    ]
  },
  {
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>`,
    badge: "COMUNIDADES",
    badgeColor: "bg-amber-500/10 text-amber-500 border-amber-500/20",
    title: "Desarrollo Comunitario & Empleo Local",
    desc: "Promovemos relaciones de confianza y progreso mutuo con las comunidades aledañas a los proyectos mineros, viales y de infraestructura.",
    points: [
      "Fomento a la contratación de mano de obra y personal local calificado.",
      "Transferencia de conocimientos y capacitación técnica en obra.",
      "Alianzas comerciales con proveedores y servicios locales de cada región.",
      "Respeto irrestricto por las costumbres, culturas y normativas comunitarias."
    ]
  },
  {
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>`,
    badge: "SOSTENIBILIDAD",
    badgeColor: "bg-emerald-500/10 text-emerald-500 border-emerald-500/20",
    title: "Sostenibilidad Ambiental & Eficiencia Energética",
    desc: "Reducimos la huella ambiental mediante el mantenimiento óptimo de equipos, uso eficiente de combustible y gestión responsable de residuos.",
    points: [
      "Flota moderna con motores de baja emisión de gases contaminantes.",
      "Manejo certificado de lubricantes, aceites usados y residuos peligrosos.",
      "Torres de iluminación LED autónomas de bajo consumo y alta eficiencia.",
      "Optimización logística para reducir recorridos innecesarios y consumo diésel."
    ]
  },
  {
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>`,
    badge: "ÉTICA & COMPLIANCE",
    badgeColor: "bg-blue-500/10 text-blue-500 border-blue-500/20",
    title: "Ética, Transparencia & Buen Gobierno Corporativo",
    desc: "Operamos con absoluta integridad en todas las relaciones comerciales con clientes públicos y privados, colaboradores y autoridades.",
    points: [
      "Tolerancia cero a la corrupción y apego estricto a las leyes peruanas.",
      "Trazabilidad documental total bajo el Sistema de Calidad ISO 9001:2015.",
      "Cumplimiento riguroso de normativas laborales (SUNAFIL) y mineras (MINEM).",
      "Contratos transparentes, condiciones claras y cumplimiento de plazos."
    ]
  }
];
---

<Layout
  title="Compromiso Social, Seguridad & Sostenibilidad | SERVITOTALES S.A.C."
  description="Conoce el compromiso de SERVITOTALES S.A.C. con la seguridad de los trabajadores, el desarrollo comunitario, la sostenibilidad ambiental y la ética corporativa."
>
  <!-- Atmospheric Hero Section with Dedicated Image -->
  <section class="relative py-20 lg:py-28 border-b border-slate-800/80 bg-[#050A14] overflow-hidden text-white">
    <div class="absolute inset-0 w-full h-full z-0 overflow-hidden pointer-events-none select-none">
      <img
        src="/images/hero-contacto.jpg"
        alt="Equipo de operaciones y personal de Servitotales en obra"
        loading="eager"
        decoding="async"
        class="w-full h-full object-cover opacity-35 contrast-115 saturate-110"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#050A14] via-[#050A14]/90 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#050A14] via-transparent to-transparent"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-5" id="social-hero">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/20 border border-emerald-500/35 text-emerald-400 font-mono text-[11px] font-bold tracking-wider uppercase">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          04 // RESPONSABILIDAD SOCIAL CORPORATIVA & SOSTENIBILIDAD
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-white font-heading leading-tight" id="social-title">
          Compromiso con la Seguridad, las Personas y el Entorno
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal" id="social-desc">
          En Servicios Totales del Perú S.A.C. integramos la idoneidad técnica con la responsabilidad social y ambiental. Desarrollamos nuestras operaciones impulsando el bienestar de los trabajadores, el crecimiento de las comunidades y la sostenibilidad en cada frente de obra.
        </p>

        <!-- Direct Action Buttons -->
        <div class="pt-3 flex flex-wrap items-center gap-3">
          <a
            href="/docs/Brochure-Corporativo-Servitotales.pdf"
            download="Brochure-Corporativo-Servitotales.pdf"
            target="_blank"
            class="px-6 py-3.5 rounded-2xl bg-amber-500 hover:bg-amber-600 text-slate-950 font-black text-xs uppercase tracking-wider transition shadow-lg flex items-center gap-2 hover:-translate-y-0.5 cursor-pointer"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
            <span>Descargar Brochure Corporativo (PDF)</span>
          </a>

          <a
            href="/contacto"
            class="px-6 py-3.5 rounded-2xl bg-slate-900/80 hover:bg-slate-800 text-white font-bold text-xs uppercase tracking-wider border border-slate-700 transition backdrop-blur-md"
          >
            <span>Contactar Asesor Técnico</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Métricas de Impacto y Compromiso -->
  <section class="py-12 border-b border-[var(--border-subtle)] bg-[var(--bg-surface)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        <div class="p-6 rounded-2xl industrial-card bg-[var(--bg-main)] border border-[var(--border-subtle)] space-y-1 text-center sm:text-left">
          <span class="text-[10px] font-mono font-bold text-slate-400 uppercase block">Cultura de Seguridad</span>
          <strong class="text-2xl sm:text-3xl font-black text-[#DC2626] font-heading block">Cero Accidentes</strong>
          <span class="text-xs text-[var(--text-secondary)]">Meta continua en cada faena</span>
        </div>

        <div class="p-6 rounded-2xl industrial-card bg-[var(--bg-main)] border border-[var(--border-subtle)] space-y-1 text-center sm:text-left">
          <span class="text-[10px] font-mono font-bold text-slate-400 uppercase block">Gestión de Calidad</span>
          <strong class="text-2xl sm:text-3xl font-black text-amber-500 font-heading block">ISO 9001:2015</strong>
          <span class="text-xs text-emerald-500 font-bold">● SGC Homologado</span>
        </div>

        <div class="p-6 rounded-2xl industrial-card bg-[var(--bg-main)] border border-[var(--border-subtle)] space-y-1 text-center sm:text-left">
          <span class="text-[10px] font-mono font-bold text-slate-400 uppercase block">Personal & Técnicos</span>
          <strong class="text-2xl sm:text-3xl font-black text-blue-500 font-heading block">100% Homologado</strong>
          <span class="text-xs text-[var(--text-secondary)]">Capacitación y seguros SST</span>
        </div>

        <div class="p-6 rounded-2xl industrial-card bg-[var(--bg-main)] border border-[var(--border-subtle)] space-y-1 text-center sm:text-left">
          <span class="text-[10px] font-mono font-bold text-slate-400 uppercase block">Alcance Social</span>
          <strong class="text-2xl sm:text-3xl font-black text-emerald-500 font-heading block">Nacional</strong>
          <span class="text-xs text-[var(--text-secondary)]">Empleo y alianzas locales</span>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 Pilares del Compromiso Social -->
  <section class="py-16 lg:py-24 border-b border-[var(--border-subtle)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-14">
      <div class="text-center max-w-3xl mx-auto space-y-3">
        <span class="text-xs font-mono font-bold text-[#DC2626] uppercase tracking-widest">// PILARES ESTRATÉGICOS</span>
        <h2 class="text-3xl sm:text-4xl font-black text-[var(--text-primary)] font-heading">
          Nuestros Cuatro Ejes de Responsabilidad Corporativa
        </h2>
        <p class="text-sm text-[var(--text-secondary)]">
          Acciones concretas que respaldan la idoneidad técnica de nuestras operaciones en minería, construcción e infraestructura.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {pillars.map((pillar) => (
          <div class="p-8 sm:p-10 rounded-3xl industrial-card bg-[var(--bg-surface)] border border-[var(--border-subtle)] space-y-5 hover:border-slate-600 transition group">
            <div class="flex items-center justify-between">
              <span class={`px-3 py-1 rounded-lg border font-mono text-[10px] font-bold uppercase tracking-wider ${pillar.badgeColor}`}>
                {pillar.badge}
              </span>
              <div class="w-10 h-10 rounded-xl bg-[var(--bg-main)] border border-[var(--border-subtle)] flex items-center justify-center text-[var(--text-primary)] group-hover:text-[#DC2626] transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={pillar.iconSvg}></svg>
              </div>
            </div>

            <div class="space-y-2">
              <h3 class="text-xl font-bold text-[var(--text-primary)] font-heading leading-tight group-hover:text-[#DC2626] transition-colors">
                {pillar.title}
              </h3>
              <p class="text-xs sm:text-sm text-[var(--text-secondary)] leading-relaxed">
                {pillar.desc}
              </p>
            </div>

            <ul class="space-y-2.5 pt-4 border-t border-[var(--border-subtle)]">
              {pillar.points.map((pt) => (
                <li class="text-xs text-[var(--text-secondary)] flex items-start gap-2.5 leading-relaxed">
                  <span class="text-emerald-500 font-bold shrink-0 mt-0.5">✓</span>
                  <span>{pt}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Box -->
  <section class="py-16 lg:py-20 bg-[var(--bg-surface)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-8 sm:p-12 rounded-3xl industrial-card bg-gradient-to-br from-slate-900 to-[#0A1224] text-white shadow-2xl space-y-6 border border-slate-800 flex flex-col md:flex-row items-center justify-between gap-8">
        <div class="space-y-3 max-w-2xl text-center md:text-left">
          <span class="text-xs font-mono font-bold text-amber-400 uppercase tracking-widest block">
            ALIANZA ESTRATÉGICA CON PROPÓSITO
          </span>
          <h2 class="text-2xl sm:text-3xl font-black text-white font-heading">
            ¿Deseas conocer más sobre nuestras políticas y estándares?
          </h2>
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Descarga nuestro Brochure Corporativo Oficial o contacta directamente con nuestro equipo técnico para consultas sobre proyectos y homologaciones.
          </p>
        </div>

        <div class="flex flex-col sm:flex-row items-center gap-3 shrink-0 w-full md:w-auto">
          <a
            href="/docs/Brochure-Corporativo-Servitotales.pdf"
            download="Brochure-Corporativo-Servitotales.pdf"
            target="_blank"
            class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-amber-500 hover:bg-amber-400 text-slate-950 font-black text-xs uppercase tracking-wider text-center transition shadow-md"
          >
            Descargar Brochure PDF
          </a>
          <a
            href="/contacto"
            class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-[#DC2626] hover:bg-[#B91C1C] text-white font-black text-xs uppercase tracking-wider text-center transition shadow-md"
          >
            Mesa de Cotizaciones
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initCompromiso() {
    gsap.fromTo('#social-hero > *', 
      { opacity: 0, y: 25 }, 
      { opacity: 1, y: 0, duration: 0.7, stagger: 0.1, ease: 'power2.out' }
    );

    ScrollTrigger.refresh();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCompromiso);
  } else {
    initCompromiso();
  }
</script>
