---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contacto & Mesa de Cotizaciones | SERVITOTALES S.A.C."
  description="Solicita cotización técnica de maquinaria pesada, lotes de EPP o suministros de ferretería. Atención inmediata y entrega en obra en todo el Perú."
>
  <!-- Atmospheric Hero Header with Dedicated Image -->
  <section class="relative py-20 lg:py-28 border-b border-slate-800/80 bg-[#050A14] overflow-hidden text-white">
    <div class="absolute inset-0 w-full h-full z-0 overflow-hidden pointer-events-none select-none">
      <img
        src="/images/hero-contacto.jpg"
        alt="Centro de operaciones y despacho logístico Servitotales S.A.C."
        loading="eager"
        decoding="async"
        class="w-full h-full object-cover opacity-40 contrast-115 saturate-110"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#050A14] via-[#050A14]/85 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#050A14] via-transparent to-transparent"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4" id="contacto-hero">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-600/20 border border-red-500/35 text-red-400 font-mono text-[11px] font-bold tracking-wider uppercase">
          <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
          06 // CONTACTO & MESA DE COTIZACIONES
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-white font-heading leading-tight">
          Mesa de Cotizaciones Técnicas y Atención Directa
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
          Comunícate con nuestros ingenieros y asesores comerciales para evaluar disponibilidad de maquinaria pesada, lotes de EPP o abastecimiento corporativo con entrega en obra.
        </p>
      </div>
    </div>
  </section>

  <!-- Contact & Form Section (2 Columns Layout) -->
  <section class="py-16 lg:py-24 border-b border-[var(--border-subtle)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <!-- Left Channels -->
        <div class="lg:col-span-5 space-y-8" id="contact-channels">
          <div class="space-y-3">
            <h2 class="text-2xl sm:text-3xl font-black text-[var(--text-primary)] font-heading">
              Canales de Atención Prioritaria
            </h2>
            <p class="text-sm text-[var(--text-secondary)]">
              Atención continua para emergencias operativas, paradas de planta y suministros directos en mina.
            </p>
          </div>

          <div class="space-y-4">
            <!-- Direct Phone -->
            <a href="tel:963895085" class="flex items-center gap-5 p-5 rounded-3xl industrial-card group transition-all">
              <div class="w-14 h-14 rounded-2xl bg-blue-600/10 border border-blue-500/30 flex items-center justify-center text-blue-600 dark:text-blue-400 group-hover:bg-blue-600 group-hover:text-white transition-all duration-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              </div>
              <div>
                <span class="text-xs text-[var(--text-muted)] block font-bold uppercase tracking-wider font-mono">Central Telefónica</span>
                <span class="text-lg sm:text-xl font-black text-[var(--text-primary)] font-heading group-hover:text-[#DC2626] transition-colors">+51 963 895 085</span>
              </div>
            </a>

            <!-- Corporate Email -->
            <a href="mailto:contacto@servitotales.com" class="flex items-center gap-5 p-5 rounded-3xl industrial-card group transition-all">
              <div class="w-14 h-14 rounded-2xl bg-red-600/10 border border-red-500/30 flex items-center justify-center text-[#DC2626] group-hover:bg-[#DC2626] group-hover:text-white transition-all duration-300">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
              </div>
              <div>
                <span class="text-xs text-[var(--text-muted)] block font-bold uppercase tracking-wider font-mono">Correo Institucional</span>
                <span class="text-lg sm:text-xl font-black text-[var(--text-primary)] font-heading group-hover:text-[#DC2626] transition-colors">contacto@servitotales.com</span>
              </div>
            </a>

            <!-- Instant WhatsApp -->
            <a
              href="https://wa.me/51963895085?text=Hola%20Servitotales%2C%20deseo%20solicitar%20una%20cotizaci%C3%B3n%20t%C3%A9cnica%20para%20maquinaria%20%2F%20suministros."
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-5 p-5 rounded-3xl bg-emerald-500/10 border border-emerald-500/30 hover:border-emerald-500 transition-all group"
            >
              <div class="w-14 h-14 rounded-2xl bg-emerald-500/20 border border-emerald-500/40 flex items-center justify-center text-emerald-600 dark:text-emerald-400 group-hover:bg-emerald-600 group-hover:text-white transition-all duration-300">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path fill="currentColor" d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"></path>
                </svg>
              </div>
              <div>
                <span class="text-xs text-emerald-600 dark:text-emerald-400 block font-bold uppercase tracking-wider font-mono">Mesa de Cotizaciones WhatsApp</span>
                <span class="text-lg sm:text-xl font-black text-[var(--text-primary)] font-heading">Atención Prioritaria 24/7</span>
              </div>
            </a>
          </div>

          <!-- Legal Sede & Brochure Box -->
          <div class="p-6 rounded-3xl industrial-card space-y-3 bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono font-bold text-amber-500 uppercase">Sede Legal & Operativa</span>
              <span class="text-[10px] font-mono font-bold text-slate-400">RUC: 20600889584</span>
            </div>
            <p class="text-xs text-[var(--text-primary)] font-semibold leading-relaxed">
              Av. Dominicos Mza. D Lote 12 Asc. Los Nardos, Callao, Lima [Perú]
            </p>
            <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
              Atención ejecutiva a cargo de Gerencia General (María Ramos Fernández) con cobertura y despacho directo a obra a nivel nacional.
            </p>
            <div class="pt-2 border-t border-[var(--border-subtle)]">
              <a
                href="/docs/Brochure-Corporativo-Servitotales.pdf"
                download="Brochure-Corporativo-Servitotales.pdf"
                target="_blank"
                class="w-full py-3 rounded-xl bg-amber-500/10 hover:bg-amber-500 text-amber-600 dark:text-amber-400 hover:text-slate-950 font-bold text-xs transition flex items-center justify-center gap-2 border border-amber-500/30"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                <span>Descargar Brochure Corporativo Oficial (PDF)</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Right Form -->
        <div class="lg:col-span-7" id="contact-form-container">
          <div class="p-8 sm:p-12 rounded-3xl industrial-card shadow-2xl relative">
            <h3 class="text-2xl sm:text-3xl font-black text-[var(--text-primary)] mb-2 font-heading">
              Solicita tu Cotización Técnica Multidivisión
            </h3>
            <p class="text-xs sm:text-sm text-[var(--text-secondary)] mb-8 font-normal">
              Completa el formulario y un asesor técnico se comunicará contigo en menos de 15 minutos.
            </p>

            <form id="contact-page-form" class="space-y-6">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider mb-2">Nombre y Apellido *</label>
                  <input type="text" id="name" name="name" required placeholder="Ej. Ing. Carlos Mendoza" class="w-full px-4 py-3.5 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[#DC2626] focus:ring-1 focus:ring-[#DC2626] text-sm transition" />
                </div>
                <div>
                  <label for="companyName" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider mb-2">Empresa / RUC *</label>
                  <input type="text" id="companyName" name="companyName" required placeholder="Ej. Constructora Andina SAC" class="w-full px-4 py-3.5 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[#DC2626] focus:ring-1 focus:ring-[#DC2626] text-sm transition" />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div>
                  <label for="phone" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider mb-2">Teléfono de Contacto *</label>
                  <input type="tel" id="phone" name="phone" required placeholder="987 654 321" class="w-full px-4 py-3.5 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[#DC2626] focus:ring-1 focus:ring-[#DC2626] text-sm transition" />
                </div>
                <div>
                  <label for="serviceType" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider mb-2">División de Requerimiento *</label>
                  <select id="serviceType" name="serviceType" required class="w-full px-4 py-3.5 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] focus:outline-none focus:border-[#DC2626] focus:ring-1 focus:ring-[#DC2626] text-sm transition">
                    <option value="Alquiler de Maquinaria Pesada (Construcción / Obras)">Alquiler de Maquinaria Pesada (Construcción / Obras)</option>
                    <option value="Minería Subterránea Trackless (Jumbos, Scooptrams, Dumpers)">Minería Subterránea Trackless (Jumbos, Scooptrams, Dumpers)</option>
                    <option value="Equipos de Protección Personal (EPP por Lotes)">Equipos de Protección Personal (EPP por Lotes)</option>
                    <option value="Ferretería Industrial, Pernos y Herramientas">Ferretería Industrial, Pernos y Herramientas</option>
                    <option value="Mobiliario Corporativo, Campamentos y Oficina">Mobiliario Corporativo, Campamentos y Oficina</option>
                    <option value="Suministros Especiales bajo Demanda">Suministros Especiales bajo Demanda</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="message" class="block text-xs font-bold text-[var(--text-primary)] uppercase tracking-wider mb-2">Detalle de la Obra o Equipos Requeridos *</label>
                <textarea id="message" name="message" rows="4" required placeholder="Indica la ubicación del proyecto, modelo o tonelaje de equipo, tiempo estimado de alquiler o lista de suministros requeridos..." class="w-full px-4 py-3.5 rounded-2xl bg-[var(--bg-main)] border border-[var(--border-strong)] text-[var(--text-primary)] placeholder-[var(--text-muted)] focus:outline-none focus:border-[#DC2626] focus:ring-1 focus:ring-[#DC2626] text-sm transition"></textarea>
              </div>

              <button type="submit" class="w-full py-4 text-xs font-black uppercase tracking-widest text-white bg-[#DC2626] hover:bg-[#B91C1C] rounded-2xl shadow-lg shadow-red-950/20 dark:shadow-red-950/60 hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center justify-center gap-3 cursor-pointer">
                <span>Enviar Requerimiento para Cotización</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
              </button>

              <div id="contact-success" class="hidden p-4 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-300 text-xs text-center font-bold">
                Solicitud procesada con éxito. Redirigiendo a nuestro canal de WhatsApp para atención inmediata...
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';

  function initContacto() {
    gsap.fromTo('#contacto-hero > *',
      { opacity: 0, y: 25 },
      { opacity: 1, y: 0, duration: 0.7, stagger: 0.1, ease: 'power2.out' }
    );

    gsap.fromTo('#contact-channels > *',
      { opacity: 0, x: -25 },
      { opacity: 1, x: 0, duration: 0.7, stagger: 0.1, delay: 0.15, ease: 'power2.out' }
    );

    gsap.fromTo('#contact-form-container',
      { opacity: 0, x: 25 },
      { opacity: 1, x: 0, duration: 0.8, delay: 0.2, ease: 'power3.out' }
    );
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initContacto);
  } else {
    initContacto();
  }

  const whatsappNumber = "51963895085";
  const form = document.getElementById('contact-page-form') as HTMLFormElement;
  const successMsg = document.getElementById('contact-success');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(form);
    const name = formData.get('name');
    const company = formData.get('companyName');
    const phone = formData.get('phone');
    const service = formData.get('serviceType');
    const message = formData.get('message');

    const whatsappText = `*COTIZACIÓN MULTIDIVISIÓN - SERVITOTALES*\n\n` +
      `*Cliente:* ${name}\n` +
      `*Empresa:* ${company}\n` +
      `*Teléfono:* ${phone}\n` +
      `*División:* ${service}\n` +
      `*Detalle del Proyecto:*\n${message}`;

    if (successMsg) {
      successMsg.classList.remove('hidden');
    }

    setTimeout(() => {
      window.open(`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappText)}`, '_blank');
    }, 1000);
  });
</script>
`;

fs.writeFileSync(contactoPath, contactoContent, 'utf8');
console.log('Successfully restored original 2-column layout in contacto.astro');
