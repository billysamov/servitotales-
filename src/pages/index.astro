<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initAnimations() {
    // Hero Entrance
    gsap.fromTo('#hero-badge', 
      { opacity: 0, y: -15 }, 
      { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }
    );
    gsap.fromTo('#hero-title', 
      { opacity: 0, y: 25 }, 
      { opacity: 1, y: 0, duration: 0.7, delay: 0.1, ease: 'power3.out' }
    );
    gsap.fromTo('#hero-desc, #hero-pills, #hero-ctas', 
      { opacity: 0, y: 20 }, 
      { opacity: 1, y: 0, duration: 0.6, stagger: 0.1, delay: 0.2, ease: 'power2.out' }
    );
    gsap.fromTo('#hero-panel', 
      { opacity: 0, x: 30 }, 
      { opacity: 1, x: 0, duration: 0.8, delay: 0.2, ease: 'power3.out' }
    );
    gsap.fromTo('.stat-card', 
      { opacity: 0, y: 20 }, 
      { opacity: 1, y: 0, duration: 0.5, stagger: 0.08, delay: 0.4, ease: 'power2.out' }
    );

    // Division Cards Scroll Animation
    const divisionCards = document.querySelectorAll('.division-card');
    if (divisionCards.length > 0) {
      gsap.fromTo(divisionCards,
        { opacity: 0, y: 40 },
        {
          opacity: 1,
          y: 0,
          duration: 0.7,
          stagger: 0.15,
          ease: 'power2.out',
          scrollTrigger: {
            trigger: '#divisiones',
            start: 'top 92%',
            toggleActions: 'play none none none'
          }
        }
      );
    }

    ScrollTrigger.refresh();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAnimations);
  } else {
    initAnimations();
  }
</script>
