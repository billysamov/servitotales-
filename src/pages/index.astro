---
import Layout from '../layouts/Layout.astro';

// Priority Supplies & EPP Quick Lines for WhatsApp
const quickSupplyLines = [
  {
    name: "Protección Respiratoria y EPP",
    tag: "Filtros P100 / 3M",
    href: "https://wa.me/51963895085?text=Hola%20Servitotales%2C%20deseo%20cotizar%3A%20Protecci%C3%B3n%20Respiratoria%20y%20EPP%20Normado"
  },
  {
    name: "Seguridad en Altura y Anticaídas",
    tag: "Arneses 4 Anillos ANSI",
    href: "https://wa.me/51963895085?text=Hola%20Servitotales%2C%20deseo%20cotizar%3A%20Arneses%20y%20Seguridad%20en%20Altura"
  },
  {
    name: "Pernos Estructurales y Fijación",
    tag: "A325 / Varillas / Tuercas",
    href: "https://wa.me/51963895085?text=Hola%20Servitotales%2C%20deseo%20cotizar%3A%20Pernos%20Estructurales%20A325"
  },
  {
    name: "Herramientas y Mobiliario de Obra",
    tag: "Herramientas / Lockers",
    href: "https://wa.me/51963895085?text=Hola%20Servitotales%2C%20deseo%20cotizar%3A%20Herramientas%20y%20Mobiliario%20de%20Oficina%20y%20Lockers"
  }
];

const marqueeItems = [
  "EQUIPOS DE PROTECCIÓN PERSONAL ANSI/OSHA",
  "FERRETERÍA PESADA Y PERNOS A325",
  "ISO 9001:2015 CERTIFICADO",
  "DESPACHO DIRECTO EN OBRA A NIVEL NACIONAL",
  "MOBILIARIO DE OFICINA Y LOCKERS METÁLICOS",
  "ALQUILER DE MAQUINARIA Y MINERÍA TRACKLESS"
];

// ORDER: 1. EPP -> 2. Ferretería y Suministros -> 3. Maquinaria
const divisions = [
  {
    title: "Equipos de Protección Personal (EPP)",
    tag: "01 // SEGURIDAD Y EPP",
    badgeColor: "text-amber-400 border-amber-500/30 bg-amber-500/10",
    summary: "Protección integral normada ANSI y OSHA para faenas mineras y construcción civil. Suministro mayorista con certificación de calidad.",
    highlights: [
      "Protección Respiratoria 3M y Filtros P100",
      "Sistemas Anticaídas, Líneas de Vida y Arneses",
      "Cascos Dieléctricos, Calzado y Trajes Ignífugos"
    ],
    href: "/epp",
    cta: "Explorar Catálogo EPP",
    img: "/images/division-epp.jpg",
    alt: "Equipos de protección personal y seguridad industrial"
  },
  {
    title: "Ferretería y Suministros Industriales",
    tag: "02 // FERRETERÍA Y SUMINISTROS",
    badgeColor: "text-blue-400 border-blue-500/30 bg-blue-500/10",
    summary: "Abastecimiento técnico de herramientas de precisión, pernería de alta resistencia, químicos, ferretería y mobiliario de oficina.",
    highlights: [
      "Herramientas Manuales, Eléctricas y Neumáticas",
      "Pernos Estructurales A325, Grado 5/8 y Abrasivos",
      "Mobiliario de Oficina, Lockers y Papelería"
    ],
    href: "/suministros",
    cta: "Explorar Catálogo Suministros",
    img: "/images/division-suministros.jpg",
    alt: "Ferretería industrial, herramientas y suministros para obras"
  },
  {
    title: "Venta y Alquiler de Maquinaria y Equipos",
    tag: "03 // MAQUINARIA Y MINERÍA",
    badgeColor: "text-red-400 border-red-500/30 bg-red-500/10",
    summary: "Flota pesada para movimiento de tierras, elevación y minería trackless con mantenimiento en obra y operadores calificados.",
    highlights: [
      "Excavadoras, Rodillos y Camiones Volquete",
      "Manlifts, Plataformas de Tijera y Montacargas",
      "Jumbos Mineros, Scooptrams y Generación Diésel"
    ],
    href: "/maquinaria",
    cta: "Explorar Catálogo Maquinaria",
    img: "/images/division-maquinaria.jpg",
    alt: "Maquinaria pesada y flota minera en operación"
  }
];

const isoPillars = [
  {
    title: "Trazabilidad y Fichas Técnicas",
    desc: "Cada lote de EPP y pernos cuenta con certificación de fábrica, lote homologado y ficha técnica de cumplimiento normativo."
  },
  {
    title: "Inspección Pre-Uso y Calidad",
    desc: "Protocolos rigurosos de control antes de cada despacho a obra para garantizar cero fallas operativas."
  },
  {
    title: "Disponibilidad y Despacho Inmediato",
    desc: "Stock permanente de suministros críticos para minería y construcción con cobertura en costa, sierra y selva."
  }
];
---

<Layout
  title="Abastecimiento de EPP, Ferretería y Suministros Industriales | SERVITOTALES S.A.C."
  description="Distribución de EPP normado ANSI/OSHA, ferretería pesada, pernos A325, suministros y alquiler de maquinaria con certificación ISO 9001:2015 en Perú."
>
  <!-- ========================================================================= -->
  <!-- 1. HERO SECTION: ENFOQUE EN EPP, FERRETERÍA Y SUMINISTROS -->
  <!-- ========================================================================= -->
  <section id="inicio" class="relative min-h-[85vh] lg:min-h-[88vh] flex flex-col justify-center pt-12 pb-16 lg:pt-16 lg:pb-24 border-b border-slate-800/80 bg-[#050A14] overflow-hidden text-white">
    <!-- Atmospheric Background Image -->
    <div class="absolute inset-0 w-full h-full z-0 overflow-hidden pointer-events-none select-none">
      <img
        id="hero-bg-img"
        src="/images/hero-fleet.jpg"
        alt="Suministros y operaciones industriales Servitotales S.A.C."
        loading="eager"
        decoding="async"
        class="w-full h-full object-cover object-right lg:object-center opacity-40 contrast-115 saturate-110 will-change-transform"
      />
      <!-- Directional Smooth Gradient Overlays -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#050A14] via-[#050A14]/90 via-45% to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#050A14] via-transparent to-transparent"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
        <!-- Left Column: Focused on EPP, Supplies & Hardware -->
        <div class="lg:col-span-7 space-y-6">
          <!-- ISO Badge -->
          <div id="hero-badge" class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-red-600/15 border border-red-500/30 text-red-400 font-mono text-[11px] font-bold tracking-wider uppercase">
            <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
            <span>ISO 9001:2015 • EPP Y SUMINISTROS INDUSTRIALES</span>
          </div>

          <!-- Main Headline focused on EPP & Hardware -->
          <h1 id="hero-title" class="text-3xl sm:text-5xl lg:text-[48px] font-black tracking-tight text-white leading-[1.15] font-heading">
            Abastecimiento de EPP, Ferretería y <br class="hidden sm:inline" />
            <span class="text-gradient-red">Suministros Industriales</span>
          </h1>

          <!-- Subtitle -->
          <p id="hero-desc" class="text-sm sm:text-base text-slate-300 leading-relaxed max-w-xl font-normal">
            Distribución corporativa de implementos de seguridad normados ANSI/OSHA, herramientas de alto torque, pernos estructurales A325 y soluciones de equipamiento con despacho inmediato en faena a nivel nacional.
          </p>

          <!-- Core Benefits -->
          <div id="hero-pills" class="flex flex-wrap items-center gap-2 sm:gap-3 text-xs text-slate-300 font-semibold pt-1">
            <span class="px-3 py-1.5 rounded-xl bg-slate-900/80 border border-slate-800 backdrop-blur-md flex items-center gap-1.5 hover:border-slate-700 transition">
              <span class="text-emerald-400">✓</span> EPP Certificado (3M, MSA)
            </span>
            <span class="px-3 py-1.5 rounded-xl bg-slate-900/80 border border-slate-800 backdrop-blur-md flex items-center gap-1.5 hover:border-slate-700 transition">
              <span class="text-blue-400">✓</span> Pernos A325 y Ferretería
            </span>
            <span class="px-3 py-1.5 rounded-xl bg-slate-900/80 border border-slate-800 backdrop-blur-md flex items-center gap-1.5 hover:border-slate-700 transition">
              <span class="text-amber-400">✓</span> Despacho en Obra 24/7
            </span>
          </div>

          <!-- Direct CTA Buttons with Brochure Viewer Link -->
          <div id="hero-ctas" class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 pt-4">
            <a
              href="/contacto"
              class="px-7 py-4 text-xs font-black uppercase tracking-widest text-white bg-[#DC2626] hover:bg-[#B91C1C] rounded-2xl shadow-xl shadow-red-950/50 hover:-translate-y-0.5 active:translate-y-0 transition-all flex items-center justify-center gap-2.5 cursor-pointer"
            >
              <span>Solicitar Cotización</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </a>

            <a
              href="/brochure"
              class="px-6 py-4 text-xs font-black uppercase tracking-widest text-amber-400 hover:text-white bg-slate-900/90 hover:bg-amber-600/90 border border-amber-500/40 rounded-2xl transition-all flex items-center justify-center gap-2 hover:-translate-y-0.5 backdrop-blur-md cursor-pointer"
              title="Ver Brochure Corporativo Oficial"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
              <span>Ver Brochure Oficial</span>
            </a>

            <a
              href="/epp"
              class="px-5 py-4 text-xs font-black uppercase tracking-widest text-slate-300 hover:text-white bg-slate-900/60 hover:bg-slate-800/90 border border-slate-700/60 rounded-2xl transition-all flex items-center justify-center gap-1.5 hover:-translate-y-0.5 backdrop-blur-md"
            >
              <span>Catálogo EPP</span>
            </a>
          </div>
        </div>

        <!-- Right Column: Quick Quotation for Supplies & EPP -->
        <div class="lg:col-span-5 flex flex-col" id="hero-panel">
          <div class="relative rounded-3xl overflow-hidden border border-slate-800 shadow-2xl bg-[#081020]/90 backdrop-blur-xl p-6 sm:p-7 space-y-4">
            <!-- Header -->
            <div class="flex items-center justify-between pb-3 border-b border-slate-800">
              <div>
                <span class="text-[10px] font-mono font-bold tracking-widest uppercase text-amber-400 block">Cotización Directa</span>
                <h3 class="text-base font-black font-heading text-white">Disponibilidad EPP y Ferretería</h3>
              </div>
              <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 text-[11px] font-bold">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>En Stock</span>
              </div>
            </div>

            <!-- Supply Selector Items -->
            <div class="space-y-2" id="hero-selector-items">
              {quickSupplyLines.map((item) => (
                <a
                  href={item.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="flex items-center justify-between p-3 rounded-xl bg-[#0D182E]/70 hover:bg-[#DC2626] hover:text-white border border-slate-800/90 hover:border-transparent transition-all text-xs font-bold text-slate-200 group shadow-sm"
                >
                  <span class="flex items-center gap-2.5">
                    <span class="w-1.5 h-1.5 rounded-full bg-amber-400 group-hover:bg-white transition-colors"></span>
                    <span>{item.name}</span>
                  </span>
                  <div class="flex items-center gap-2">
                    <span class="text-[10px] font-mono text-slate-400 group-hover:text-white/90">{item.tag}</span>
                    <svg class="w-3.5 h-3.5 text-slate-500 group-hover:text-white group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                  </div>
                </a>
              ))}
            </div>

            <!-- Footer Contact Call -->
            <div class="pt-3 border-t border-slate-800/80 flex items-center justify-between text-xs">
              <span class="text-slate-400 font-medium">Atención Comercial WhatsApp</span>
              <a
                href="https://wa.me/51963895085?text=Hola%20Servitotales%2C%20deseo%20solicitar%20atenci%C3%B3n%20comercial."
                target="_blank"
                rel="noopener noreferrer"
                class="text-xs font-bold text-emerald-400 hover:text-emerald-300 flex items-center gap-1 font-mono"
              >
                <span>+51 963 895 085</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- Performance Strip -->
      <div id="hero-stats" class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-12 pt-8 border-t border-slate-800/70">
        <div class="p-4 rounded-2xl bg-[#0B1528]/60 border border-slate-800/80 text-center sm:text-left stat-card">
          <div class="text-2xl sm:text-3xl font-black text-white font-heading">ISO 9001</div>
          <div class="text-xs text-slate-300 font-semibold mt-0.5">Calidad Certificada</div>
        </div>
        <div class="p-4 rounded-2xl bg-[#0B1528]/60 border border-slate-800/80 text-center sm:text-left stat-card">
          <div class="text-2xl sm:text-3xl font-black text-white font-heading">100%</div>
          <div class="text-xs text-slate-300 font-semibold mt-0.5">EPP Normado</div>
        </div>
        <div class="p-4 rounded-2xl bg-[#0B1528]/60 border border-slate-800/80 text-center sm:text-left stat-card">
          <div class="text-2xl sm:text-3xl font-black text-white font-heading">24/7</div>
          <div class="text-xs text-slate-300 font-semibold mt-0.5">Despacho en Obra</div>
        </div>
        <div class="p-4 rounded-2xl bg-[#0B1528]/60 border border-slate-800/80 text-center sm:text-left stat-card">
          <div class="text-2xl sm:text-3xl font-black text-white font-heading">Nacional</div>
          <div class="text-xs text-slate-300 font-semibold mt-0.5">Cobertura de Envíos</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 2. KINETIC MARQUEE TICKER -->
  <!-- ========================================================================= -->
  <section class="py-4 bg-[var(--bg-surface)] border-b border-[var(--border-subtle)] overflow-hidden relative">
    <div class="marquee-track flex items-center gap-12 whitespace-nowrap">
      {[...marqueeItems, ...marqueeItems].map((item) => (
        <div class="flex items-center gap-12 flex-shrink-0">
          <span class="text-xs font-black tracking-widest text-[var(--text-primary)] uppercase flex items-center gap-3 font-heading">
            <span class="w-2 h-2 rounded-full bg-[#DC2626]"></span>
            <span>{item}</span>
          </span>
          <span class="text-xs font-mono font-bold text-amber-500 uppercase tracking-widest">// SERVITOTALES</span>
        </div>
      ))}
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 3. CATÁLOGO DE SOLUCIONES (ORDER: 1. EPP -> 2. FERRETERÍA -> 3. MAQUINARIA) -->
  <!-- ========================================================================= -->
  <section id="divisiones" class="py-20 lg:py-28 relative border-b border-[var(--border-subtle)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mb-14 space-y-3" id="divisions-header">
        <span class="tech-label">01 // CATÁLOGOS TÉCNICOS Y SOLUCIONES INTEGRALES</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-[var(--text-primary)] leading-tight font-heading">
          Suministros de Seguridad, Ferretería y Equipamiento Pesado
        </h2>
        <p class="text-sm sm:text-base text-[var(--text-secondary)] leading-relaxed">
          Abastecimiento homologado para operaciones de minería, obras civiles e industria en todo el territorio nacional.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {divisions.map((div) => (
          <div class="division-card rounded-3xl industrial-card overflow-hidden flex flex-col justify-between group shadow-lg hover:shadow-2xl transition-all duration-300 bg-[var(--bg-surface)] border border-[var(--border-subtle)]">
            <!-- 100% Crisp Real Image Header -->
            <div class="relative h-56 sm:h-60 w-full overflow-hidden bg-slate-900 border-b border-[var(--border-subtle)]">
              <img
                src={div.img}
                alt={div.alt}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              />
              
              <!-- Floating Category Pill -->
              <div class="absolute top-3.5 left-3.5 z-10">
                <span class={`inline-flex items-center px-3 py-1.5 rounded-xl text-[11px] font-mono font-bold uppercase tracking-wider bg-[#060B14]/90 border shadow-md backdrop-blur-md ${div.badgeColor}`}>
                  {div.tag}
                </span>
              </div>
            </div>

            <!-- Card Body Content -->
            <div class="p-6 sm:p-7 flex-1 flex flex-col justify-between space-y-6">
              <div class="space-y-4">
                <h3 class="text-xl sm:text-2xl font-black text-[var(--text-primary)] font-heading group-hover:text-[#DC2626] transition-colors leading-tight min-h-[56px] flex items-center">
                  {div.title}
                </h3>

                <p class="text-xs text-[var(--text-secondary)] leading-relaxed min-h-[48px]">
                  {div.summary}
                </p>

                <div class="pt-2 border-t border-[var(--border-subtle)]/60">
                  <span class="text-[10px] font-mono font-bold uppercase tracking-wider text-slate-400 block mb-2.5">
                    Líneas Destacadas:
                  </span>
                  <ul class="space-y-2">
                    {div.highlights.map((item) => (
                      <li class="text-xs text-[var(--text-secondary)] leading-snug flex items-center gap-2">
                        <span class="w-1.5 h-1.5 rounded-full bg-[#DC2626] shrink-0"></span>
                        <span class="font-medium text-[var(--text-primary)]">{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>

              <!-- CTA Link -->
              <div class="pt-4 border-t border-[var(--border-subtle)] flex items-center justify-between">
                <a
                  href={div.href}
                  class="inline-flex items-center gap-2 text-xs font-black uppercase tracking-wider text-[#DC2626] hover:text-[#B91C1C] hover:translate-x-1 transition-all"
                >
                  <span>{div.cta}</span>
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M17 8l4 4m0 0l-4 4m4-4H3"></path>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 4. SECCIÓN ISO 9001 (NEW): GARANTÍA Y HOMOLOGACIÓN TÉCNICA -->
  <!-- ========================================================================= -->
  <section id="iso-section" class="py-16 lg:py-24 border-b border-[var(--border-subtle)] bg-[var(--bg-surface)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-5 space-y-5">
          <span class="tech-label">02 // GARANTÍA DE GESTIÓN DE LA CALIDAD</span>
          <h2 class="text-3xl sm:text-4xl font-black text-[var(--text-primary)] font-heading leading-tight">
            Calidad Certificada bajo Estándar ISO 9001:2015
          </h2>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed">
            Nuestro Sistema de Gestión de la Calidad (SGC) asegura la conformidad técnica de cada implemento de seguridad, perno de alta resistencia y equipo suministrado a nuestros clientes corporativos.
          </p>
        </div>

        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-3 gap-4">
          {isoPillars.map((pillar) => (
            <div class="p-6 rounded-3xl industrial-card bg-[var(--bg-main)] border border-[var(--border-subtle)] space-y-3">
              <div class="w-8 h-8 rounded-xl bg-amber-500/10 text-amber-500 flex items-center justify-center font-bold text-sm">
                ✓
              </div>
              <h3 class="text-sm font-bold text-[var(--text-primary)] font-heading leading-snug">{pillar.title}</h3>
              <p class="text-xs text-[var(--text-secondary)] leading-relaxed">{pillar.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ========================================================================= -->
  <!-- 5. SECCIÓN COMPROMISO SOCIAL: PROPÓSITO, NIÑEZ & ONG CORAZONES FELICES -->
  <!-- ========================================================================= -->
  <section id="social-preview-section" class="py-16 lg:py-24 border-b border-[var(--border-subtle)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="p-5 sm:p-8 lg:p-12 rounded-3xl industrial-card bg-gradient-to-br from-slate-900 via-[#0A182F] to-slate-900 text-white shadow-2xl border border-slate-800 flex flex-col lg:flex-row items-center justify-between gap-8 overflow-hidden">
        <div class="space-y-4 flex-1 max-w-2xl">
          <div class="flex flex-wrap items-center gap-2">
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-red-500/20 border border-red-500/30 text-red-400 font-mono text-[11px] font-bold tracking-wider uppercase">
              <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
              <span>COMPROMISO SOCIAL Y PROPÓSITO</span>
            </div>
            <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-400 font-mono text-[11px] font-bold">
              <span>Alianza con ONG Corazones Felices</span>
            </div>
          </div>

          <h2 class="text-2xl sm:text-4xl font-black text-white font-heading leading-tight">
            Unidos por la Niñez: Sembrando para la Generación Líder del Futuro
          </h2>
          
          <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">
            Al abastecerte con Servitotales eres parte directa de la ayuda social brindada a la niñez vulnerable a través de la ONG Corazones Felices. Integramos la excelencia técnica e ISO 9001 con un impacto humano real en el Perú.
          </p>

          <div class="flex flex-wrap gap-4 text-xs font-semibold text-slate-300 pt-1">
            <span class="flex items-center gap-1.5 text-red-400">● Nutrición y Clubes Infantiles</span>
