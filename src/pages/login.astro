---
import '../styles/global.css';
---

<!doctype html>
<html lang="es" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Acceso al Panel de Control | SERVITOTALES S.A.C.</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet" />
    <script is:inline>
      const theme = (() => {
        if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
          return localStorage.getItem('theme');
        }
        return 'dark';
      })();
      if (theme === 'light') {
        document.documentElement.classList.remove('dark');
      } else {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased min-h-screen flex flex-col justify-between font-sans selection:bg-red-600 selection:text-white">
    
    <!-- Top Minimal Navbar -->
    <header class="w-full px-4 sm:px-6 py-3 bg-slate-900 border-b border-slate-800 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <div class="w-8 h-8 rounded-lg bg-red-600 text-white font-black flex items-center justify-center text-sm shadow-md">
          ST
        </div>
        <div class="flex flex-col">
          <span class="text-sm font-black tracking-wider text-white font-heading leading-tight">
            SERVI<span class="text-red-500">TOTALES</span> <span class="text-[10px] font-mono text-slate-400">ADMIN</span>
          </span>
          <span class="text-[8px] font-mono font-bold text-amber-400">SGC ISO 9001:2015</span>
        </div>
      </div>

      <a href="/" class="px-3 py-1.5 rounded-lg text-xs font-semibold text-slate-300 hover:text-white bg-slate-800 hover:bg-slate-700 transition flex items-center gap-1.5 border border-slate-700">
        <svg class="w-3.5 h-3.5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        <span>Volver a la Web</span>
      </a>
    </header>

    <!-- Center Login Card (Fully Responsive for Mobile & Desktop) -->
    <main class="flex-1 flex items-center justify-center p-4 sm:p-6">
      <div class="w-full max-w-md p-6 sm:p-8 rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl space-y-6">
        
        <div class="text-center space-y-2">
          <div class="w-12 h-12 rounded-xl bg-red-500/10 text-red-500 flex items-center justify-center mx-auto border border-red-500/20">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
          </div>
          <h1 class="text-xl sm:text-2xl font-black text-white font-heading">Acceso al Panel de Control</h1>
          <p class="text-xs text-slate-400">Gestión de Contenidos, Catálogo de Flota y Cotizaciones.</p>
        </div>

        <!-- Credential Info Box -->
        <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 text-xs space-y-1.5">
          <div class="flex items-center gap-1.5 font-bold text-slate-300">
            <svg class="w-3.5 h-3.5 text-blue-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <span>Credenciales Administrativas Demo:</span>
          </div>
          <div class="font-mono text-[11px] pl-5 space-y-0.5 text-slate-400">
            <div>Usuario: <strong class="text-white">admin@servitotales.com</strong></div>
            <div>Clave: <strong class="text-white">admin2026</strong></div>
          </div>
        </div>

        <form id="admin-login-form" class="space-y-4">
          <div class="space-y-1.5">
            <label for="admin-email" class="block text-xs font-bold text-slate-300 uppercase tracking-wider">Usuario Corporativo</label>
            <input
              type="email"
              id="admin-email"
              name="email"
              required
              value="admin@servitotales.com"
              placeholder="admin@servitotales.com"
              class="w-full px-3.5 py-3 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none focus:border-red-500 transition"
            />
          </div>

          <div class="space-y-1.5">
            <label for="admin-password" class="block text-xs font-bold text-slate-300 uppercase tracking-wider">Contraseña</label>
            <input
              type="password"
              id="admin-password"
              name="password"
              required
              value="admin2026"
              placeholder="••••••••"
              class="w-full px-3.5 py-3 rounded-xl bg-slate-950 border border-slate-800 text-xs text-white focus:outline-none focus:border-red-500 transition"
            />
          </div>

          <div id="login-error" class="hidden p-2.5 rounded-xl bg-red-500/10 border border-red-500/30 text-xs font-bold text-red-400 text-center">
            Credenciales no válidas.
          </div>

          <button
            type="submit"
            class="w-full py-3.5 text-xs font-bold uppercase tracking-wider text-white bg-red-600 hover:bg-red-500 rounded-xl shadow-lg transition-all cursor-pointer flex items-center justify-center gap-2"
          >
            <span>Ingresar al Sistema</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
          </button>
        </form>
      </div>
    </main>

    <!-- Clean Footer -->
    <footer class="w-full py-3 px-6 border-t border-slate-900 bg-slate-950 text-center text-[11px] text-slate-500 font-mono">
      Servicios Totales del Perú S.A.C. • Panel de Control v3.2 • SGC ISO 9001:2015
    </footer>

    <script>
      const form = document.getElementById('admin-login-form');
      const errorBox = document.getElementById('login-error');

      if (localStorage.getItem('servitotales_admin_auth') === 'true') {
        window.location.href = '/admin';
      }

      form?.addEventListener('submit', (e) => {
        e.preventDefault();
        const email = (document.getElementById('admin-email') as HTMLInputElement).value.trim();
        const password = (document.getElementById('admin-password') as HTMLInputElement).value.trim();

        if ((email === 'admin@servitotales.com' && password === 'admin2026') || (email && email.includes('@') && password.length >= 4)) {
          localStorage.setItem('servitotales_admin_auth', 'true');
          localStorage.setItem('servitotales_admin_user', email);
          window.location.href = '/admin';
        } else {
          if (errorBox) errorBox.classList.remove('hidden');
        }
      });
    </script>
  </body>
</html>
