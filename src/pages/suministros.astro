---

<Layout
  title="Ferretería Industrial, Mobiliario y Suministros | SERVITOTALES S.A.C."
  description="Abastecimiento corporativo de ferretería pesada, pernos A325, abrasivos, mobiliario de oficina y pinturas industriales."
>
  <!-- Atmospheric Hero Header with Division Image -->
  <section class="relative py-20 lg:py-28 border-b border-slate-800/80 bg-[#050A14] overflow-hidden text-white">
    <div class="absolute inset-0 w-full h-full z-0 overflow-hidden pointer-events-none select-none">
      <img
        id="sum-hero-img"
        src="/images/division-suministros.jpg"
        alt="Ferretería y suministros industriales Servitotales"
        loading="eager"
        decoding="async"
        class="w-full h-full object-cover opacity-45 contrast-115 saturate-110 will-change-transform"
      />
      <div class="absolute inset-0 bg-gradient-to-r from-[#050A14] via-[#050A14]/85 to-transparent"></div>
      <div class="absolute inset-0 bg-gradient-to-t from-[#050A14] via-transparent to-transparent"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="max-w-3xl space-y-4" id="sum-hero-content">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/20 border border-blue-500/35 text-blue-400 font-mono text-[11px] font-bold tracking-wider uppercase">
          <span class="w-2 h-2 rounded-full bg-blue-400 animate-pulse"></span>
          05 // FERRETERÍA Y SUMINISTROS
        </span>
        <h1 class="text-3xl sm:text-5xl font-black text-white font-heading leading-tight">
          Ferretería Industrial, Mobiliario y Suministros
        </h1>
        <p class="text-base sm:text-lg text-slate-300 leading-relaxed font-normal">
          Soluciones de aprovisionamiento continuo para empresas, talleres de maestranza y frentes de obra. Pernos de alta resistencia, abrasivos, pinturas y mobiliario corporativo.
        </p>
      </div>
    </div>
  </section>

  <!-- Categories -->
  <section class="py-16 lg:py-24 border-b border-[var(--border-subtle)]">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-20">
      {supplyCategories.map((cat) => (
        <div class="space-y-8 category-block">
          <div class="border-b border-[var(--border-subtle)] pb-4">
            <h2 class="text-2xl sm:text-3xl font-black text-[var(--text-primary)] font-heading">{cat.title}</h2>
            <p class="text-sm text-[var(--text-secondary)] mt-1">{cat.description}</p>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6">
            {cat.items.map((item) => (
              <div class="item-card rounded-3xl industrial-card overflow-hidden flex flex-col justify-between group hover:border-blue-500 transition-all duration-300">
                <!-- Product Image Header -->
                <div class="relative h-44 w-full overflow-hidden bg-slate-900">
                  <img
                    src={item.image}
                    alt={item.name}
                    loading="lazy"
                    decoding="async"
                    class="w-full h-full object-cover group-hover:scale-108 transition-transform duration-500"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                  <span class="absolute top-3 left-3 px-2.5 py-1 rounded-lg bg-black/70 backdrop-blur-md text-[10px] font-mono font-bold text-blue-400 border border-blue-500/20 uppercase tracking-wider">
                    {item.type}
                  </span>
                </div>

                <!-- Product Details -->
                <div class="p-5 flex-1 flex flex-col justify-between space-y-4">
                  <div class="space-y-2">
                    <h3 class="text-sm font-bold text-[var(--text-primary)] group-hover:text-blue-500 transition-colors leading-snug">
                      {item.name}
                    </h3>
                    <p class="text-xs text-[var(--text-secondary)] leading-relaxed">
                      {item.specs}
                    </p>
                  </div>

                  <div class="pt-4 border-t border-[var(--border-subtle)]">
                    <a
                      href={`https://wa.me/51963895085?text=Hola%20Servitotales%2C%20deseo%20cotizar%20suministros%20de%3A%20${encodeURIComponent(item.name)}`}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="w-full py-2.5 px-4 rounded-xl bg-[var(--bg-main)] hover:bg-blue-600 hover:text-white border border-[var(--border-subtle)] hover:border-transparent text-xs font-bold text-center block transition-all shadow-sm"
                    >
                      Solicitar Cotización
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>
</Layout>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  function initSuministros() {
    gsap.fromTo('#sum-hero-content > *',
      { opacity: 0, y: 25 },
      { opacity: 1, y: 0, duration: 0.7, stagger: 0.1, ease: 'power2.out' }
    );

    document.querySelectorAll('.category-block').forEach(block => {
      const items = block.querySelectorAll('.item-card');
      if (items.length > 0) {
        gsap.fromTo(items,
          { opacity: 0, y: 30 },
          {
            opacity: 1,
            y: 0,
            duration: 0.6,
            stagger: 0.08,
            ease: 'power2.out',
            scrollTrigger: {
              trigger: block,
              start: 'top 92%'
            }
          }
        );
      }
    });

    ScrollTrigger.refresh();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initSuministros);
  } else {
    initSuministros();
  }
</script>
